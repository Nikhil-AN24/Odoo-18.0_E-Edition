<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit res.users form to add Reports App Access toggle -->
    <record id="view_users_form_inherit_reports" model="ir.ui.view">
        <field name="name">res.users.form.inherit.reports</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Targeting the 'access_rights' page directly and adding a group at the top -->
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Reports App Access">
                    <field name="show_reports_app"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit res.users form to inject o_reports_form class.
         CSS in hide_action_menu.css uses this class to hide -->
    <record id="view_users_form_reports_class" model="ir.ui.view">
        <field name="name">res.users.form.reports.class</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_reports_form" separator=" "/>
            </xpath>
        </field>
    </record>

    <!-- Inherit sale.order form to inject o_reports_form class.
        the CSS gear-hide rule to sale.order forms opened from our Sales list views. -->
    <record id="view_sale_order_form_reports_class" model="ir.ui.view">
        <field name="name">sale.order.form.reports.class</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_reports_form" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>