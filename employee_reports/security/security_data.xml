<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_reports" model="ir.module.category">
        <field name="name">Reports Access</field>
        <field name="description">Helps you manage access to the Reports app.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_reports_user" model="res.groups">
        <field name="name">Reports User</field>
        <field name="category_id" ref="module_category_reports"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
