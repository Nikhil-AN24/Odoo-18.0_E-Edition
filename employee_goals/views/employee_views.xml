<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Form View Inherit -->
    <record id="view_employee_form_goals" model="ir.ui.view">
        <field name="name">hr.employee.form.goals</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add Smart Buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_goals" type="object" class="oe_stat_button" icon="fa-bullseye">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="active_goal_count" widget="integer"/> / <field name="goal_count" widget="integer"/>
                        </span>
                        <span class="o_stat_text">Goals</span>
                    </div>
                </button>
                <button name="action_view_performance_ratings" type="object" class="oe_stat_button" icon="fa-star">
                    <field name="latest_rating" widget="badge"/>
                </button>
                <button name="action_create_goal" type="object" class="oe_stat_button" icon="fa-plus-square" string="Create Goal"/>
            </xpath>

            <!-- Add Goals Tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Goals &amp; Performance">
                    <group>
                        <group string="Goal Statistics">
                            <field name="goal_count"/>
                            <field name="active_goal_count"/>
                            <field name="completed_goal_count"/>
                            <field name="goal_completion_rate" widget="percentage"/>
                        </group>
                        <group string="Performance Ratings">
                            <field name="latest_rating"/>
                            <field name="previous_rating"/>
                        </group>
                        <group string="Status Information">
                            <field name="lmi_status"/>
                            <field name="employment_status"/>
                        </group>
                    </group>
                    <group string="Current Goals">
                        <field name="current_goal_ids" nolabel="1">
                            <list>
                                <field name="title"/>
                                <field name="goal_type_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="progress" widget="progressbar"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </group>
                    <group string="Performance History">
                        <field name="performance_rating_ids" nolabel="1">
                            <list>
                                <field name="rating_period"/>
                                <field name="period_start_date"/>
                                <field name="period_end_date"/>
                                <field name="rating"/>
                                <field name="rating_score"/>
                                <field name="goal_completion_rate" widget="percentage"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

