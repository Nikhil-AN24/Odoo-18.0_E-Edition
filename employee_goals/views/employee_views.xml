    <!-- Employee Search View Inherit -->
    <record id="view_employee_search_goals" model="ir.ui.view">
        <field name="name">hr.employee.search.goals</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Rating O" name="rating_o" domain="[('latest_rating','=','o')]"/>
                <filter string="Rating A+" name="rating_a_plus" domain="[('latest_rating','=','a_plus')]"/>
                <filter string="Rating A" name="rating_a" domain="[('latest_rating','=','a')]"/>
                <filter string="Rating B+" name="rating_b_plus" domain="[('latest_rating','=','b_plus')]"/>
                <filter string="Rating B" name="rating_b" domain="[('latest_rating','=','b')]"/>
                <separator/>
                <filter string="LMI Status" name="lmi_active" domain="[('lmi_status','=',True)]"/>
                <separator/>
                <filter string="Employment Status A" name="employment_a" domain="[('employment_status','=','a')]"/>
                <filter string="Employment Status B" name="employment_b" domain="[('employment_status','=','b')]"/>
                <filter string="Employment Status C" name="employment_c" domain="[('employment_status','=','c')]"/>
                <filter string="Employment Status D" name="employment_d" domain="[('employment_status','=','d')]"/>
                <group expand="0" string="Group By">
                    <filter string="Latest Rating" name="group_latest_rating" context="{'group_by':'latest_rating'}"/>
                    <filter string="LMI Status" name="group_lmi_status" context="{'group_by':'lmi_status'}"/>
                    <filter string="Employment Status" name="group_employment_status" context="{'group_by':'employment_status'}"/>
                </group>
            </xpath>
        </field>
    </record>

