<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_employee_goal_tree" model="ir.ui.view">
        <field name="name">employee.goal.list</field>
        <field name="model">employee.goal</field>
        <field name="arch" type="xml">
            <list string="Goals" decoration-danger="is_overdue" decoration-info="state=='draft'" decoration-success="state=='completed'">
                <field name="title"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="goal_type_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="progress" widget="progressbar"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-warning="state in ('submitted','in_progress')" decoration-success="state=='completed'"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_employee_goal_form" model="ir.ui.view">
        <field name="name">employee.goal.form</field>
        <field name="model">employee.goal</field>
        <field name="arch" type="xml">
            <form string="Goal">
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'submitted'" class="oe_highlight" groups="employee_goals.group_goal_team_manager"/>
                    <button name="action_start" string="Start Progress" type="object" invisible="state != 'approved'" class="oe_highlight"/>
                    <button name="action_complete" string="Mark Complete" type="object" invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_hold" string="Put On Hold" type="object" invisible="state not in ('approved','in_progress')"/>
                    <button name="action_start" string="Resume" type="object" invisible="state != 'on_hold'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('completed','cancelled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'" groups="employee_goals.group_goal_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_milestones" type="object" class="oe_stat_button" icon="fa-flag-checkered">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="completed_milestone_count" widget="integer"/> / <field name="milestone_count" widget="integer"/>
                                </span>
                                <span class="o_stat_text">Milestones</span>
                            </div>
                        </button>
                        <button name="action_add_daily_update" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="total_updates" widget="statinfo" string="Daily Updates"/>
                        </button>
                        <button name="action_view_attachments" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="title" class="oe_edit_only"/>
                        <h1>
                            <field name="title" placeholder="e.g. Increase Sales by 20%"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="goal_type_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe the goal and expected outcomes..."/>
                    </group>
                    <notebook>
                        <page string="Milestones" name="milestones">
                            <field name="milestone_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="target_date"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="completed_milestone_count" string="Completed Milestones"/>
                                <field name="milestone_count" string="Total Milestones"/>
                            </group>
                        </page>
                        <page string="Daily Tracking" name="tracking">
                            <field name="tracking_ids">
                                <list create="0" delete="0">
                                    <field name="date"/>
                                    <field name="progress_percentage" widget="progressbar"/>
                                    <field name="status" widget="badge"/>
                                    <field name="hours_spent"/>
                                </list>
                            </field>
                        </page>
                        <page string="Details" name="details">
                            <group>
                                <group>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="use_manual_progress"/>
                                    <field name="manual_progress" invisible="not use_manual_progress"/>
                                </group>
                                <group>
                                    <field name="target_value"/>
                                    <field name="achieved_value"/>
                                    <field name="unit_of_measure"/>
                                </group>
                            </group>
                            <group>
                                <field name="notes" placeholder="Additional notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                 <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_employee_goal_kanban" model="ir.ui.view">
        <field name="name">employee.goal.kanban</field>
        <field name="model">employee.goal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="title"/>
                <field name="employee_id"/>
                <field name="goal_type_id"/>
                <field name="progress"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="end_date"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.is_overdue.raw_value ? 'oe_kanban_color_2' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="title"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="employee_id"/>
                                    <div>
                                        <field name="goal_type_id" widget="badge"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="progress" widget="progressbar"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="end_date" widget="date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_employee_goal_calendar" model="ir.ui.view">
        <field name="name">employee.goal.calendar</field>
        <field name="model">employee.goal</field>
        <field name="arch" type="xml">
            <calendar string="Goals Calendar" date_start="start_date" date_stop="end_date" color="state" mode="month">
                <field name="title"/>
                <field name="employee_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_employee_goal_search" model="ir.ui.view">
        <field name="name">employee.goal.search</field>
        <field name="model">employee.goal</field>
        <field name="arch" type="xml">
            <search string="Search Goals">
                <field name="title"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="goal_type_id"/>
                <field name="manager_id"/>
                <filter string="My Goals" name="my_goals" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="My Team Goals" name="my_team_goals" domain="[('manager_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="High Priority" name="high_priority" domain="[('priority', '=', '3')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Goal Type" name="group_type" context="{'group_by': 'goal_type_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: All Yearly Goals -->
    <record id="action_employee_goal_all" model="ir.actions.act_window">
        <field name="name">Org Wide Goals</field>
        <field name="res_model">employee.goal</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_employee_goal_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Yearly Goal
            </p>
            <p>
                Set and track employee yearly goals to improve performance and productivity.
            </p>
        </field>
    </record>

    <!-- Action: Yearly Goals -->
    <record id="action_employee_goal_my" model="ir.actions.act_window">
        <field name="name">Yearly Goals</field>
        <field name="res_model">employee.goal</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_employee_goal_search"/>
        <field name="context">{'search_default_my_goals': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Yearly Goal
            </p>
            <p>
                Track your personal yearly goals and milestones.
            </p>
        </field>
    </record>

    <!-- Action: Team Yearly Goals -->
    <record id="action_employee_goal_team" model="ir.actions.act_window">
        <field name="name">Team Yearly Goals</field>
        <field name="res_model">employee.goal</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_employee_goal_search"/>
        <field name="context">{'search_default_my_team_goals': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No team yearly goals yet
            </p>
            <p>
                Monitor and manage your team's yearly goals and progress.
            </p>
        </field>
    </record>


</odoo>
