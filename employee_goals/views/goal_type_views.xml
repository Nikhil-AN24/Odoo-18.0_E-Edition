<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Goal Type Tree View -->
    <record id="view_goal_type_tree" model="ir.ui.view">
        <field name="name">goal.type.list</field>
        <field name="model">goal.type</field>
        <field name="arch" type="xml">
            <list string="Goal Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="goal_count"/>
                <field name="requires_approval" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Goal Type Form View -->
    <record id="view_goal_type_form" model="ir.ui.view">
        <field name="name">goal.type.form</field>
        <field name="model">goal.type</field>
        <field name="arch" type="xml">
            <form string="Goal Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_goals" type="object" class="oe_stat_button" icon="fa-bullseye">
                            <field name="goal_count" widget="statinfo" string="Goals"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., Sales Target, Training Program"/>
                            <field name="code" placeholder="e.g., SALES, TRAIN"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="requires_approval"/>
                            <field name="auto_create_milestones"/>
                            <field name="default_milestone_count" invisible="not auto_create_milestones"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Detailed description of this goal type..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Goal Type Kanban View -->
    <record id="view_goal_type_kanban" model="ir.ui.view">
        <field name="name">goal.type.kanban</field>
        <field name="model">goal.type</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="color"/>
                <field name="category"/>
                <field name="goal_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-3">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <span class="badge text-bg-primary">
                                    <field name="code"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted">
                                    <span class="badge" t-attf-class="text-bg-#{record.category.raw_value === 'training' ? 'info' : record.category.raw_value === 'performance' ? 'success' : record.category.raw_value === 'organizational' ? 'warning' : 'secondary'}">
                                        <field name="category"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-3">
                                <div class="oe_kanban_bottom_left">
                                    <i class="fa fa-bullseye"/> <field name="goal_count"/> Goals
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Goal Type Search View -->
    <record id="view_goal_type_search" model="ir.ui.view">
        <field name="name">goal.type.search</field>
        <field name="model">goal.type</field>
        <field name="arch" type="xml">
            <search string="Goal Types">
                <field name="name"/>
                <field name="code"/>
                <filter string="Training" name="training" domain="[('category', '=', 'training')]"/>
                <filter string="Performance" name="performance" domain="[('category', '=', 'performance')]"/>
                <filter string="Custom" name="custom" domain="[('category', '=', 'custom')]"/>
                <filter string="Organizational" name="organizational" domain="[('category', '=', 'organizational')]"/>
                <separator/>
                <filter string="Requires Approval" name="requires_approval" domain="[('requires_approval', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Goal Type Action -->
    <record id="action_goal_type" model="ir.actions.act_window">
        <field name="name">Goal Types</field>
        <field name="res_model">goal.type</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Goal Type
            </p>
            <p>
                Goal types help categorize and manage different types of employee goals.
            </p>
        </field>
    </record>

</odoo>
