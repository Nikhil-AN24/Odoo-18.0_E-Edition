<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Goal Daily Tracking Tree View -->
    <record id="view_goal_daily_tracking_tree" model="ir.ui.view">
        <field name="name">goal.daily.tracking.list</field>
        <field name="model">goal.daily.tracking</field>
        <field name="arch" type="xml">
            <list string="Daily Tracking" decoration-success="status == 'completed'"
                  decoration-warning="status == 'at_risk'" decoration-danger="status == 'blocked'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="goal_id"/>
                <field name="milestone_id"/>
                <field name="skip_work_done"/>
                <field name="progress_percentage" widget="progressbar"/>
                <field name="hours_spent" sum="Total Hours"/>
                <field name="status" widget="badge" decoration-success="status == 'completed'"
                       decoration-warning="status == 'at_risk'" decoration-danger="status == 'blocked'"
                       decoration-info="status == 'on_track'"/>
                <field name="work_done" optional="hide"/>
                <field name="manager_feedback" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Goal Daily Tracking Form View -->
    <record id="view_goal_daily_tracking_form" model="ir.ui.view">
        <field name="name">goal.daily.tracking.form</field>
        <field name="model">goal.daily.tracking</field>
        <field name="arch" type="xml">
            <form string="Daily Tracking">
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments" type="object" class="oe_stat_button" icon="fa-files-o">
                            <field name="attachment_count" widget="statbutton" string="Attachments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="goal_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="milestone_id"/>
                            <field name="progress_percentage" widget="progressbar"/>
                            <field name="milestone_progress" widget="progressbar"/>
                            <field name="hours_spent"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Details" name="work_details">
                            <group>
                                <field name="skip_work_done" widget="radio"/>
                                <field name="work_done" widget="text" placeholder="Describe what you accomplished today..." invisible="skip_work_done == 'yes'"/>
                                <field name="challenges" widget="text" placeholder="Any challenges or blockers you faced..."/>
                                <field name="support_needed" widget="text" placeholder="What support or resources do you need..."/>
                                <field name="next_steps" widget="text" placeholder="What are your next steps..."/>
                            </group>
                        </page>
                        <page string="Manager Feedback" name="manager_feedback">
                            <group>
                                <field name="manager_id"/>
                                <field name="feedback_date"/>
                                <field name="manager_feedback" widget="text" placeholder="Manager's feedback and comments..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                  <chatter/>
            </form>
        </field>
    </record>

    <!-- Goal Daily Tracking Kanban View -->
    <record id="view_goal_daily_tracking_kanban" model="ir.ui.view">
        <field name="name">goal.daily.tracking.kanban</field>
        <field name="model">goal.daily.tracking</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="goal_id"/>
                <field name="progress_percentage"/>
                <field name="status"/>
                <field name="hours_spent"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="display_name"/>
                                    </strong>
                                </div>
                                <span class="badge rounded-pill" t-att-class="{'text-bg-success': record.status.raw_value == 'completed',
                                             'text-bg-warning': record.status.raw_value == 'at_risk',
                                             'text-bg-danger': record.status.raw_value == 'blocked',
                                             'text-bg-info': record.status.raw_value == 'on_track'}">
                                    <field name="status"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="goal_id"/>
                                <div>
                                    <i class="fa fa-calendar"/> <field name="date"/>
                                </div>
                                <div>
                                    <i class="fa fa-clock-o"/> <field name="hours_spent"/> hrs
                                </div>
                                <div class="mt-2">
                                    <field name="progress_percentage" widget="progressbar"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="employee_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Goal Daily Tracking Calendar View -->
    <record id="view_goal_daily_tracking_calendar" model="ir.ui.view">
        <field name="name">goal.daily.tracking.calendar</field>
        <field name="model">goal.daily.tracking</field>
        <field name="arch" type="xml">
            <calendar string="Daily Tracking Calendar" date_start="date" color="status" mode="month">
                <field name="employee_id"/>
                <field name="goal_id"/>
                <field name="progress_percentage"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <!-- Goal Daily Tracking Pivot View -->
    <record id="view_goal_daily_tracking_pivot" model="ir.ui.view">
        <field name="name">goal.daily.tracking.pivot</field>
        <field name="model">goal.daily.tracking</field>
        <field name="arch" type="xml">
            <pivot string="Daily Tracking Analysis">
                <field name="employee_id" type="row"/>
                <field name="date" interval="week" type="col"/>
                <field name="hours_spent" type="measure"/>
                <field name="progress_percentage" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Goal Daily Tracking Graph View -->
    <record id="view_goal_daily_tracking_graph" model="ir.ui.view">
        <field name="name">goal.daily.tracking.graph</field>
        <field name="model">goal.daily.tracking</field>
        <field name="arch" type="xml">
            <graph string="Daily Tracking Graph" type="line">
                <field name="date" interval="day"/>
                <field name="progress_percentage" type="measure"/>
                <field name="hours_spent" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Goal Daily Tracking Search View -->
    <record id="view_goal_daily_tracking_search" model="ir.ui.view">
        <field name="name">goal.daily.tracking.search</field>
        <field name="model">goal.daily.tracking</field>
        <field name="arch" type="xml">
            <search string="Daily Tracking">
                <field name="employee_id"/>
                <field name="goal_id"/>
                <field name="milestone_id"/>
                <field name="date"/>
                <field name="status"/>
                <filter string="My Updates" name="my_updates"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="Today" name="today"
                        domain="[('date', '=', context_today())]"/>
                <filter string="This Week" name="this_week"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(weeks=1)))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)))]"/>
                <separator/>
                <filter string="On Track" name="on_track" domain="[('status', '=', 'on_track')]"/>
                <filter string="At Risk" name="at_risk" domain="[('status', '=', 'at_risk')]"/>
                <filter string="Blocked" name="blocked" domain="[('status', '=', 'blocked')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <separator/>
                <filter string="Needs Support" name="needs_support"
                        domain="[('support_needed', '!=', False)]"/>
                <filter string="Has Challenges" name="has_challenges"
                        domain="[('challenges', '!=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Goal" name="group_goal" context="{'group_by': 'goal_id'}"/>
                    <filter string="Milestone" name="group_milestone" context="{'group_by': 'milestone_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- My Daily Updates Action -->
    <record id="action_goal_daily_tracking_my" model="ir.actions.act_window">
        <field name="name">My Daily Updates</field>
        <field name="res_model">goal.daily.tracking</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_updates': 1, 'search_default_this_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first daily update!
            </p>
            <p>
                Track your daily progress, challenges, and achievements on your goals.
            </p>
        </field>
    </record>

    <!-- Team Daily Updates Action -->
    <record id="action_goal_daily_tracking_team" model="ir.actions.act_window">
        <field name="name">Team Daily Updates</field>
        <field name="res_model">goal.daily.tracking</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_my_team_updates': 1, 'search_default_this_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No team daily updates yet!
            </p>
            <p>
                View and manage daily updates from your team members.
            </p>
        </field>
    </record>

</odoo>
