<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Security Categories -->
        <record id="module_category_goal_management" model="ir.module.category">
            <field name="name">Goal Management</field>
            <field name="description">Manage employee goals and performance</field>
            <field name="sequence">10</field>
        </record>

        <!-- User Groups -->
        <record id="group_goal_user" model="res.groups">
            <field name="name">User: Own Goals Only</field>
            <field name="category_id" ref="module_category_goal_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Employee can view and update their own goals</field>
        </record>

        <record id="group_goal_team_manager" model="res.groups">
            <field name="name">Manager: Team Goals</field>
            <field name="category_id" ref="module_category_goal_management"/>
            <field name="implied_ids" eval="[(4, ref('group_goal_user'))]"/>
            <field name="comment">Manager can view and manage team goals</field>
        </record>

        <record id="group_goal_manager" model="res.groups">
            <field name="name">Manager: All Goals</field>
            <field name="category_id" ref="module_category_goal_management"/>
            <field name="implied_ids" eval="[(4, ref('group_goal_team_manager')), (4, ref('hr.group_hr_user'))]"/>
            <field name="comment">Can manage all goals and performance ratings</field>
        </record>

        <!-- Record Rules -->

        <!-- Goal Type Rules -->
        <record id="goal_type_rule_all" model="ir.rule">
            <field name="name">Goal Type: All Users</field>
            <field name="model_id" ref="model_goal_type"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Employee Goal Rules -->
        <record id="employee_goal_rule_user" model="ir.rule">
            <field name="name">Employee Goal: Own Goals</field>
            <field name="model_id" ref="model_employee_goal"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_goal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="employee_goal_rule_team_manager" model="ir.rule">
            <field name="name">Employee Goal: Team Manager</field>
            <field name="model_id" ref="model_employee_goal"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_goal_team_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="employee_goal_rule_manager" model="ir.rule">
            <field name="name">Employee Goal: Manager All</field>
            <field name="model_id" ref="model_employee_goal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_goal_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Milestone Rules -->
        <record id="goal_milestone_rule_user" model="ir.rule">
            <field name="name">Goal Milestone: Own Milestones</field>
            <field name="model_id" ref="model_goal_milestone"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_goal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="goal_milestone_rule_team_manager" model="ir.rule">
            <field name="name">Goal Milestone: Team Manager</field>
            <field name="model_id" ref="model_goal_milestone"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_goal_team_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="goal_milestone_rule_manager" model="ir.rule">
            <field name="name">Goal Milestone: Manager All</field>
            <field name="model_id" ref="model_goal_milestone"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_goal_manager'))]"/>
        </record>

        <!-- Daily Tracking Rules -->
        <record id="goal_daily_tracking_rule_user" model="ir.rule">
            <field name="name">Daily Tracking: Own Updates</field>
            <field name="model_id" ref="model_goal_daily_tracking"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_goal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="goal_daily_tracking_rule_team_manager" model="ir.rule">
            <field name="name">Daily Tracking: Team Manager</field>
            <field name="model_id" ref="model_goal_daily_tracking"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_goal_team_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="goal_daily_tracking_rule_manager" model="ir.rule">
            <field name="name">Daily Tracking: Manager All</field>
            <field name="model_id" ref="model_goal_daily_tracking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_goal_manager'))]"/>
        </record>

        <!-- Performance Rating Rules -->
        <record id="performance_rating_rule_user" model="ir.rule">
            <field name="name">Performance Rating: Own Ratings</field>
            <field name="model_id" ref="model_performance_rating"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_goal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="performance_rating_rule_team_manager" model="ir.rule">
            <field name="name">Performance Rating: Team Manager</field>
            <field name="model_id" ref="model_performance_rating"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_goal_team_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="performance_rating_rule_manager" model="ir.rule">
            <field name="name">Performance Rating: Manager All</field>
            <field name="model_id" ref="model_performance_rating"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_goal_manager'))]"/>
        </record>

    </data>
</odoo>
