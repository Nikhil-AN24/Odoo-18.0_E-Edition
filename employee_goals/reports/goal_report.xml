<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Goal Report Action -->
    <record id="action_report_employee_goal" model="ir.actions.report">
        <field name="name">Employee Goal</field>
        <field name="model">employee.goal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_goals.report_employee_goal</field>
        <field name="report_file">employee_goals.report_employee_goal</field>
        <field name="binding_model_id" ref="model_employee_goal"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Goal - %s' % (object.name)</field>
    </record>

    <!-- Performance Rating Report Action -->
    <record id="action_report_performance_rating" model="ir.actions.report">
        <field name="name">Performance Rating</field>
        <field name="model">performance.rating</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_goals.report_performance_rating</field>
        <field name="report_file">employee_goals.report_performance_rating</field>
        <field name="binding_model_id" ref="model_performance_rating"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Performance Rating - %s' % (object.employee_id.name)</field>
    </record>
</odoo>
