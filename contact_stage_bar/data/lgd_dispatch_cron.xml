<odoo>
    <data noupdate="1">
        <record id="lgd_dispatch_follow_up_cron" model="ir.cron">
            <field name="name">LGD Dispatch: daily follow-up</field>
            <field name="model_id" ref="contact_stage_bar.model_lgd_dispatch"/>
            <field name="state">code</field>
            <field name="code">model._lgd_cron_follow_up()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
