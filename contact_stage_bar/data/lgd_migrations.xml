<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <function model="purchase.order.line"
                  name="_lgd_migrate_collector_column"/>

        <function model="purchase.order.line"
                  name="_lgd_backfill_sale_line_links"/>

        <function model="res.partner"
                  name="_lgd_convert_text_addresses"/>

        <function model="sale.order"
                  name="_lgd_backfill_order_source"/>

        <!-- Mirror slips already uploaded on parcels onto their orders, so
             orders that pre-date the mirroring show them too. -->
        <function model="lgd.dispatch"
                  name="_lgd_backfill_slip_attachments"/>

        <!-- Merge numbering counters that ended up sharing a prefix, and
             renumber any document issued a duplicate. -->
        <function model="lgd.doc.series"
                  name="_lgd_repair_numbering"/>

        <!-- Number offline stones created before the LGD-OFF- series existed. -->
        <function model="product.template"
                  name="_lgd_backfill_offline_stock_numbers"/>

        <!-- Make lgd_stock_number unique among active stones and add the
             partial unique index. Must run AFTER the backfill above. -->
        <function model="product.template"
                  name="_lgd_repair_duplicate_stock_numbers"/>

        <!-- Stones raised from a Customer RFQ were created non-storable, so
             their stock moves never wrote a quant and Dispatch saw 0 on hand.
             Re-enables tracking only; it does not create stock. -->
        <function model="product.template"
                  name="_lgd_backfill_storable_stones"/>

        <function model="sale.order.line"
                  name="_lgd_reclassify_certification"/>

        <!-- The Indian localisation has no Inter State mapping for the 1.5%
             diamond rate, so an out-of-Maharashtra sale kept CGST + SGST and
             the Tax Invoice printed them. Creates the row only where it is
             missing and the two taxes agree on their rate. -->
        <function model="account.fiscal.position"
                  name="_lgd_ensure_gst_tax_mappings"/>

        <delete model="ir.ui.view"
                search="[('name', '=', 'sale.order.form.lgd.resend.offline.push')]"/>

    </data>
</odoo>
