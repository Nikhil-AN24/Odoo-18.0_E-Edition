<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="your_custom_view_id" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="(//div[@class='oe_title']/span[@class='o_form_label'])[1]" position="replace">
                <span class="o_form_label" invisible="state not in ('draft', 'sent')">Request for PO </span>
            </xpath>

            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="location" readonly="state != 'draft'"/>
            </xpath>

            <!-- Discount % / payment days are now per-line (PRD §5.6), derived
                 from the vendor master and shown in the order_line list below —
                 no header-level Discount/Payment Terms fields anymore. -->

            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="attributes">
                <attribute name="widget">integer</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='qty_received']" position="attributes">
                <attribute name="widget">integer</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='qty_invoiced']" position="attributes">
                <attribute name="widget">integer</attribute>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>

            <xpath expr="(//field[@name='date_order'])[1]" position="attributes">
                <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
            </xpath>

            <xpath expr="//div[@name='reminder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="can_edit_po_pricing" invisible="1"/>
                <field name="can_edit_rate" invisible="1"/>
            </xpath>
            <!-- Products grid editable for anyone who can edit at least one column:
                 plain LGD Procurement (Per ct. Rate only) and Managers/Admin/SuperAdmin
                 (all 4 pricing fields). Column-level readonly then gates each field. -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">not can_edit_rate</attribute>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                <attribute name="readonly">1</attribute>
                <attribute name="options">{'no_open': True}</attribute>
            </xpath>

            <!-- Hide the "Description" column (standard field 'name') in the Products list, for everyone. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- Products grid is view-only for everyone. The pricing columns
                 (Discount, Per ct. Rate, Vendor Discount %, Payment Terms) are
                 re-enabled for privileged roles via can_edit_po_pricing above. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='date_planned']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="product_display"
                       string="Product"
                       groups="contact_stage_bar.group_lgd_procurement"
                       readonly="1"
                       options="{'no_open': True}"/>
                <!-- (i) info button: opens Additional / Purchase Information tabs.
                     Shape/Colour/Clarity/Cut/Carat/Quantity live in those tabs now. -->
                <button name="action_open_line_info" type="object"
                        icon="fa-info-circle" title="Information"/>
            </xpath>

            <!-- Remove the add-line controls (Add a product / section / note, Catalog). -->
            <xpath expr="//field[@name='order_line']/list/control" position="replace"/>

            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/button[@name='action_purchase_history']" position="replace"/>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="phone_number"/>
                <field name="email"/>
                <label for="vendor_street" string="Address"/>
                <div class="o_address_format">
                    <field name="vendor_street" placeholder="Street..." class="o_address_street"/>
                    <field name="vendor_street_2" placeholder="Street 2..." class="o_address_street"/>
                    <field name="vendor_city" placeholder="City" class="o_address_city"/>
                    <field name="vendor_state" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                    <field name="vendor_zip" placeholder="ZIP" class="o_address_zip"/>
                    <field name="vendor_country" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                </div>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='taxes_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>

            <!-- Total Amount (price_subtotal) removed from the Products grid. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- Kept columns beside Product: Discount, Per ct. Rate, Vendor Discount %,
                 Payment Terms, Expected Net. The 4 pricing ones are editable only for
                 Admin / LGD Procurement Manager / LGD SuperAdmin. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="can_edit_po_pricing" column_invisible="1"/>
                <field name="can_edit_rate" column_invisible="1"/>
                <field name="custom_discount" string="Discount" optional="show" readonly="not can_edit_po_pricing"/>
                <field name="rate_usd" string="Per ct. Rate" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show" readonly="not can_edit_rate"/>
                <field name="per_ct_discounted_rate" string="Per ct. Discounted Rate" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="discount_percent" string="Vendor Discount %" optional="show" readonly="not can_edit_po_pricing"/>
                <field name="payment_days" string="Payment Terms (Days)" optional="show" readonly="not can_edit_po_pricing"/>
                <field name="expected_net" string="Expected Net" widget="monetary" optional="show" readonly="1"/>
            </xpath>

            <xpath expr="//page[@name='purchase_delivery_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- "Confirm Order" (draft_confirm / bid_confirm) keeps its native visibility
                 in both draft and sent states, so the PO can be confirmed manually as well
                 as through the automatic QC path in sale_order.py. -->

            <!-- Hide "Send PO by Email" button — state = purchase. -->
            <xpath expr="//button[@name='action_rfq_send'][@context=&quot;{'send_rfq':False}&quot;]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide the "Print RFQ" buttons (both draft and sent states). -->
            <xpath expr="//button[@name='print_quotation'][@invisible=&quot;state != 'draft'&quot;]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='print_quotation'][@invisible=&quot;state != 'sent'&quot;]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Totals footer: Expected Net (untaxed) → GST +1.5% → Total,
                 replacing the standard tax_totals widget. -->
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="expected_net_total" widget="monetary"/>
                <field name="gst_amount" widget="monetary"/>
                <field name="grand_total" widget="monetary" class="oe_subtotal_footer_separator"/>
            </xpath>

            <!-- Draft-state RFQ mail button keeps its native label ("Send by Email"). -->
        </field>
    </record>

    <!-- Line-info dialog opened by the (i) button on the Products grid. -->
    <record id="view_purchase_order_line_info_form" model="ir.ui.view">
        <field name="name">purchase.order.line.info.form</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <form string="Line Information" create="false" edit="false">
                <sheet>
                    <notebook>
                        <page string="Additional Information">
                            <group>
                                <field name="shapes" string="Shape" readonly="1"/>
                                <field name="color" string="Colour" readonly="1"/>
                                <field name="clarity" string="Clarity" readonly="1"/>
                                <field name="cut" string="Cut" readonly="1"/>
                                <field name="carat_weight" string="Carat" readonly="1"/>
                                <field name="product_qty" string="Quantity" readonly="1"/>
                            </group>
                        </page>
                        <page string="Purchase Information">
                            <group>
                                <field name="currency_name" invisible="1"/>
                                <!-- Bank Rate only matters for foreign (USD) buys;
                                     hidden when the PO currency is INR. -->
                                <field name="bank_rate" string="Bank Rate" readonly="1"
                                       invisible="currency_name == 'INR'"/>
                                <field name="stone_type" string="Stone Type" readonly="1"/>
                                <field name="stone_certification_type" string="Certification" readonly="1"/>
                                <field name="price_unit" string="Unit Price" readonly="1"/>
                                <field name="weight" string="Weight" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_order_kpis_tree_inherit_weight" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.inherit.weight</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='amount_total']" position="attributes">
                <attribute name="string">Total Amount</attribute>
            </xpath>
            <xpath expr="//list//field[@name='amount_total']" position="after">
                <field name="total_weight" optional="show"/>
            </xpath>
            <!-- Hide the "Buyer" column for LGD Procurement users -->
            <xpath expr="//list//field[@name='user_id']" position="attributes">
                <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_inherit_weight" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.weight</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='amount_total']" position="attributes">
                <attribute name="string">Total Amount</attribute>
            </xpath>
            <xpath expr="//list//field[@name='amount_total']" position="after">
                <field name="total_weight" optional="show"/>
            </xpath>
            <!-- Hide the "Buyer" column for LGD Procurement users -->
            <xpath expr="//list//field[@name='user_id']" position="attributes">
                <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_view_tree_hide_buyer" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.hide.buyer</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <!-- Hide the "Buyer" column for LGD Procurement users -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
            </xpath>
        </field>
    </record>
</odoo>