<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_customer_rfq_list" model="ir.ui.view">
        <field name="name">customer.rfq.list</field>
        <field name="model">customer.rfq</field>
        <field name="arch" type="xml">
            <list string="Customer RFQ">
                <field name="name"/>
                <field name="partner_id"
                       string="Company Name"
                       groups="contact_stage_bar.group_lgd_sales,contact_stage_bar.group_lgd_sales_manager,contact_stage_bar.group_lgd_logistics,contact_stage_bar.group_lgd_shipment,contact_stage_bar.group_lgd_accounting,contact_stage_bar.group_lgd_hr,contact_stage_bar.group_lgd_marketing,base.group_system"/>
                <field name="customer_phone" invisible="1"/>
                <field name="customer_email"
                       groups="contact_stage_bar.group_lgd_sales,contact_stage_bar.group_lgd_sales_manager,contact_stage_bar.group_lgd_logistics,contact_stage_bar.group_lgd_shipment,contact_stage_bar.group_lgd_accounting,contact_stage_bar.group_lgd_hr,contact_stage_bar.group_lgd_marketing,base.group_system"/>
                <field name="customer_address"
                       groups="contact_stage_bar.group_lgd_sales,contact_stage_bar.group_lgd_sales_manager,contact_stage_bar.group_lgd_logistics,contact_stage_bar.group_lgd_shipment,contact_stage_bar.group_lgd_accounting,contact_stage_bar.group_lgd_hr,contact_stage_bar.group_lgd_marketing,base.group_system"/>
                <field name="shape_ids" widget="many2many_tags"/>
                <field name="carat"/>
                <field name="color"/>
                <field name="clarity"/>
                <field name="size"/>
                <!-- Procurement cost: never shown to Sales or Sales Managers.
                     group_lgd_sales_manager implies group_lgd_sales, so negating
                     the one group covers both roles. -->
                <field name="price" groups="!contact_stage_bar.group_lgd_sales"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'sent_to_procurement'"
                       decoration-success="state == 'sent_back_to_sales'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_customer_rfq_form" model="ir.ui.view">
        <field name="name">customer.rfq.form</field>
        <field name="model">customer.rfq</field>
        <field name="arch" type="xml">
            <form string="Customer RFQ">
                <header>
                    <!-- Send to Procurement: visible to any logged-in user in draft state. -->                
                    <button name="action_send_to_procurement" 
                    string="Send to Procurement" 
                    type="object" 
                    class="btn-primary" 
                    invisible="state != 'draft'"/>
                    <!-- Send back to Sales: Procurement + Admin, in sent_to_procurement -->
                    <button name="action_send_back_to_sales"
                    string="Send back to Sales"
                    type="object" class="btn-primary"
                    invisible="state != 'sent_to_procurement'"
                    groups="contact_stage_bar.group_lgd_procurement,base.group_system"/>
                    <!-- Create Offline Order: Sales/Admin only, after Procurement sent back -->
                    <button name="action_create_offline_order" 
                    string="Create Offline Order" type="object" class="btn-primary" 
                    invisible="state != 'sent_back_to_sales'" groups="contact_stage_bar.group_lgd_sales,base.group_system"/>

                    <!-- Cancel: available at any point before an Offline Order
                         exists. Always goes through the reason wizard. -->
                    <button name="action_open_cancel_wizard"
                            string="Cancel" type="object"
                            invisible="state in ('cancel', 'offline_order_created')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,sent_to_procurement,sent_back_to_sales,offline_order_created"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <!-- Read-only record of why this quote was dropped. -->
                    <group string="Cancellation" invisible="state != 'cancel'">
                        <group>
                            <field name="cancel_reason_ids" widget="many2many_tags" readonly="1"/>
                            <field name="cancelled_by_id" readonly="1"/>
                            <field name="cancelled_on" readonly="1"/>
                        </group>
                        <group>
                            <field name="cancel_comment" readonly="1"
                                   invisible="not cancel_comment"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="partner_id" string="Company Name"
                                   groups="contact_stage_bar.group_lgd_sales,contact_stage_bar.group_lgd_sales_manager,contact_stage_bar.group_lgd_logistics,contact_stage_bar.group_lgd_shipment,contact_stage_bar.group_lgd_accounting,contact_stage_bar.group_lgd_hr,contact_stage_bar.group_lgd_marketing,base.group_system"
                                   readonly="state != 'draft'"/>
                            <field name="customer_phone" invisible="1"/>
                            <field name="customer_email"
                                   groups="contact_stage_bar.group_lgd_sales,contact_stage_bar.group_lgd_sales_manager,contact_stage_bar.group_lgd_logistics,contact_stage_bar.group_lgd_shipment,contact_stage_bar.group_lgd_accounting,contact_stage_bar.group_lgd_hr,contact_stage_bar.group_lgd_marketing,base.group_system"
                                   invisible="1" readonly="state != 'draft'"/>
                            <field name="customer_address"
                                   groups="contact_stage_bar.group_lgd_sales,contact_stage_bar.group_lgd_sales_manager,contact_stage_bar.group_lgd_logistics,contact_stage_bar.group_lgd_shipment,contact_stage_bar.group_lgd_accounting,contact_stage_bar.group_lgd_hr,contact_stage_bar.group_lgd_marketing,base.group_system"
                                   invisible="1" readonly="state != 'draft'"/>

                            <field name="stone_type" widget="radio" options="{'horizontal': true}"
                                   required="1" readonly="state != 'draft'"/>
                            <field name="stone_certification_type" widget="radio" options="{'horizontal': true}"
                                   invisible="not stone_type" required="stone_type"
                                   readonly="state != 'draft'"/>
                            <!-- Growth Method — Lab-grown + Non-Certified only. -->
                            <field name="growth_method" widget="selection_badge"
                                   invisible="stone_type != 'lab_grown' or stone_certification_type != 'non_certified'"
                                   required="stone_type == 'lab_grown' and stone_certification_type == 'non_certified'"
                                   readonly="state != 'draft'"/>
                            <field name="lab_type" widget="radio" options="{'horizontal': true}"
                                   invisible="stone_certification_type != 'certified'"
                                   readonly="state != 'draft'"/>
                            <field name="lab_type_other"
                                   string="Other Lab"
                                   placeholder="e.g. HRD, GCAL, EGL..."
                                   invisible="stone_certification_type != 'certified' or lab_type != 'other'"
                                   required="stone_certification_type == 'certified' and lab_type == 'other'"
                                   readonly="state != 'draft'"/>

                            <field name="shape_ids" widget="many2many_tags" required="1"
                                   options="{'no_quick_create': False}"
                                   readonly="state != 'draft'"/>
                            <field name="carat"
                                   invisible="stone_certification_type == 'non_certified'"
                                   readonly="state != 'draft'"/>
                            <field name="color" required="1" readonly="state != 'draft'"/>
                            <field name="clarity" required="1" readonly="state != 'draft'"/>

                            <field name="size"
                                   invisible="stone_certification_type == 'certified'"
                                   required="stone_certification_type == 'non_certified'"
                                   readonly="state != 'draft'"/>
                            <field name="quantity"
                                   invisible="stone_certification_type == 'non_certified'"
                                   readonly="state != 'draft'"/>


                            <field name="carat_min" invisible="1"/>
                            <field name="carat_max" invisible="1"/>
                            <field name="colour_mode" invisible="1"/>
                            <field name="colour_white" invisible="1"/>
                            <field name="colour_fancy" invisible="1"/>
                            <field name="fancy_intensity" invisible="1"/>
                            <field name="fancy_overtone" invisible="1"/>
                            <field name="clarity_grade" invisible="1"/>
                            <field name="clarity_non_cert" invisible="1"/>
                            <field name="fluorescence_colour_sel" invisible="1"/>
                            <field name="stone_certification" invisible="1"/>
                        </group>
                        <group>
                            <field name="is_price_visible_for_user" invisible="1"/>
                            <field name="is_price_readonly" invisible="1"/>
                            <field name="currency_id" invisible="1"/>

                            <field name="procurement_currency" string="Currency"
                                   widget="selection_badge"
                                   readonly="is_price_readonly"
                                   groups="base.group_system,contact_stage_bar.group_lgd_procurement,contact_stage_bar.group_lgd_procurement_manager"/>
                            <field name="price" string="Procurement Price/carat"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   invisible="not is_price_visible_for_user"
                                   readonly="is_price_readonly"
                                   groups="!contact_stage_bar.group_lgd_sales"/>
                            <field name="total_price" string="Sales Price/carat"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   invisible="not is_price_visible_for_user"
                                   groups="!contact_stage_bar.group_lgd_procurement"/>

                            <field name="owner_id" string="Owner"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- Quantity & size — Lab grown + Non-Certified only.
                         Unit toggles which of the two size_line_ids lists renders;
                         both bind the same one2many, differ only by Quantity column header (ct vs pcs). -->
                    <group string="Quantity &amp; size"
                           invisible="stone_type != 'lab_grown' or stone_certification_type != 'non_certified'">
                        <div colspan="2" class="text-muted mb-2">
                            Select quantity either by total carat weight or by number of pieces.
                        </div>
                        <field name="unit_type" widget="selection_badge" string="Unit"
                               readonly="state != 'draft'"/>
                        <field name="size_line_ids" nolabel="1" colspan="2"
                               context="{'default_rfq_id': id}"
                               readonly="state != 'draft'"
                               invisible="unit_type == 'pieces'">
                            <list editable="bottom">
                                <field name="quantity" string="Quantity (ct)"/>
                                <field name="length_mm" string="Length (mm)"/>
                                <field name="width_mm" string="Width (mm)"/>
                                <field name="depth_mm" string="Depth (mm)"/>
                            </list>
                        </field>
                        <field name="size_line_ids" nolabel="1" colspan="2"
                               context="{'default_rfq_id': id}"
                               readonly="state != 'draft'"
                               invisible="unit_type != 'pieces'">
                            <list editable="bottom">
                                <field name="quantity" string="Quantity (pcs)"/>
                                <field name="length_mm" string="Length (mm)"/>
                                <field name="width_mm" string="Width (mm)"/>
                                <field name="depth_mm" string="Depth (mm)"/>
                            </list>
                        </field>
                    </group>

                    <!-- Cut, polish & symmetry — Certified only. -->
                    <group string="Cut, polish &amp; symmetry"
                           invisible="stone_certification_type != 'certified'">
                        <field name="cut_preset" widget="selection_badge" nolabel="1" colspan="2"
                               readonly="state != 'draft'"/>
                        <group col="3" colspan="2">
                            <group>
                                <field name="cut_grade_ids" string="Cut"
                                       widget="many2many_checkboxes"
                                       readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="polish_grade_ids" string="Polish"
                                       widget="many2many_checkboxes"
                                       readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="symmetry_grade_ids" string="Symmetry"
                                       widget="many2many_checkboxes"
                                       readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <!-- Legacy single-select fields kept for schema/history compat. -->
                        <field name="cut_grade" invisible="1"/>
                        <field name="polish_grade" invisible="1"/>
                        <field name="symmetry_grade" invisible="1"/>
                    </group>

                    <!-- Fluorescence — Certified only. -->
                    <group string="Fluorescence"
                           invisible="stone_certification_type != 'certified'">
                        <field name="fluorescence_grade_ids" string="Fluorescence"
                               widget="many2many_checkboxes"
                               readonly="state != 'draft'"/>
                        <!-- Legacy single-select field kept for schema/history compat. -->
                        <field name="fluorescence_intensity_sel" invisible="1"/>
                    </group>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_customer_rfq_search" model="ir.ui.view">
        <field name="name">customer.rfq.search</field>
        <field name="model">customer.rfq</field>
        <field name="arch" type="xml">
            <search string="Search Customer RFQ">
                <field name="name"/>
                <field name="shape_ids"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sent to Procurement" name="sent_to_procurement" domain="[('state', '=', 'sent_to_procurement')]"/>
                <filter string="Sent back to Sales" name="sent_back_to_sales" domain="[('state', '=', 'sent_back_to_sales')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Cancellation Reason" name="by_cancel_reason" context="{'group_by': 'cancel_reason_ids'}"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="by_state" context="{'group_by': 'state'}"/>
                    <filter string="Availability" name="by_availability" context="{'group_by': 'availability_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION: Customer RFQ (Sales side) -->
    <record id="action_customer_rfq_sales" model="ir.actions.act_window">
        <field name="name">Customer RFQ</field>
        <field name="res_model">customer.rfq</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_customer_rfq_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new Customer RFQ</p>
        </field>
    </record>

    <!-- ACTION: Customer Orders (Procurement side)                   -->
    <!-- Shows only RFQs that have been sent to Procurement           -->
    <record id="action_customer_orders_procurement" model="ir.actions.act_window">
        <field name="name">Customer Quotations</field>
        <field name="res_model">customer.rfq</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_customer_rfq_search"/>
        <field name="domain">[('state', '=', 'sent_to_procurement')]</field>
        <field name="context">{'from_customer_orders': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer orders sent by sales yet</p>
        </field>
    </record>

    <!-- MENUS  -->
    <!-- Custom 'Sales' top-level menu (recreates the UI-created menu
         that had xml_id contact_stage_bar.menu_sales_3).
         It points to sale.action_orders (standard Sales orders action). -->
    <record id="action_dynamic_sales_orders" model="ir.actions.server">
        <field name="name">Sales Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action_vals = dict(env.ref('sale.action_orders').sudo().read()[0])
action_vals['id'] = env.ref('contact_stage_bar.action_dynamic_sales_orders').id
action_vals['name'] = 'Sales'
action_vals['display_name'] = 'Sales'
action_vals.pop('path', None)
action_vals.pop('xml_id', None)

# No New button here either: orders reach this list from the RFQ and online
# flows, they are not keyed in by hand. hide_cog_menu drops the control-panel
# cog (Import / Export / Duplicate / Delete) via the CogMenu patch in
# static/src/js/hide_cog_menu.js. Both are set on the action context so they
# apply to this action only and leave sale.view_order_form usable elsewhere.
action_vals['context'] = {'create': False, 'hide_cog_menu': True}

if env.user.has_group('base.group_system') or env.user.has_group('contact_stage_bar.group_lgd_procurement'):
    action_vals['domain'] = []
elif env.user.has_group('contact_stage_bar.group_lgd_sales_manager'):
    # Manager sees ALL except Ankit and Aarav
    action_vals['domain'] = ['|', ('user_id', '=', False), ('user_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]
else:
    # Standard salesperson sees ONLY their own
    action_vals['domain'] = [('user_id', '=', env.uid)]

action = action_vals
        ]]></field>
    </record>

    <record id="menu_sales_3" model="ir.ui.menu">
        <field name="name">Sales</field>
        <field name="parent_id" eval="False"/>
        <field name="sequence">2</field>
        <field name="action" ref="contact_stage_bar.action_dynamic_sales_orders"/>
        <field name="web_icon">contact_stage_bar,static/description/icon.png</field>
        <field name="active" eval="True"/>
        <field name="groups_id" eval="[(4, ref('contact_stage_bar.group_lgd_sales')), (4, ref('base.group_system'))]"/>
    </record>

    <!-- Customer RFQ menu under the custom Sales top-level menu -->
    <menuitem id="menu_customer_rfq_sales" name="Customer RFQ" parent="menu_sales_3" action="action_customer_rfq_sales" sequence="15" groups="contact_stage_bar.group_lgd_sales,base.group_system"/>

    <!-- Onboarding menu -->
    <!-- <menuitem id="menu_onboarding_sales" name="Onboarding" parent="menu_sales_3" action="contact_stage_bar.action_customer_onboarding" sequence="21" groups="contact_stage_bar.group_lgd_sales,base.group_system"/> -->

    <!-- Run on every module install/upgrade to hide the standard Sales root -->
    <function model="ir.ui.menu" name="_reparent_customer_rfq"/>

    <!-- Customer Orders menu under Purchase -->
    <menuitem id="menu_customer_orders_procurement" name="Customer Quotations" parent="purchase.menu_purchase_root" action="action_customer_orders_procurement" sequence="-1" groups="contact_stage_bar.group_lgd_procurement,base.group_system"/>
    
    <!-- Orders: sale.order list inside Procurement.
         Separate server action so the breadcrumb shows "Orders" instead
         of "Sales" when accessed from Procurement. Same group-aware domain
         logic as action_dynamic_sales_orders. -->
    <record id="action_dynamic_cfq_orders_procurement" model="ir.actions.server">
        <field name="name">Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action_vals = dict(env.ref('sale.action_orders').sudo().read()[0])
action_vals['id'] = env.ref('contact_stage_bar.action_dynamic_cfq_orders_procurement').id
action_vals['name'] = 'Orders'
action_vals['display_name'] = 'Orders'
action_vals.pop('path', None)
action_vals.pop('xml_id', None)

# Procurement reads the orders Sales has raised; it never raises them here, so
# the New button and the control-panel cog (Import / Export / Duplicate /
# Delete) are both dropped. Setting them on the action context scopes this to
# this action alone, rather than create="0" on the view, which would take the
# button away from every other place sale.view_order_form is used.
action_vals['context'] = {'create': False, 'hide_cog_menu': True}

if env.user.has_group('base.group_system'):
    # Admin sees every CFQ Order without any restriction.
    action_vals['domain'] = []

# LGD Procurement users see ALL Orders EXCEPT those belonging to (Ankit & Aarav)
elif env.user.has_group('contact_stage_bar.group_lgd_procurement'):
    action_vals['domain'] = ['|', ('user_id', '=', False), ('user_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]

elif env.user.has_group('contact_stage_bar.group_lgd_sales_manager'):
    # Sales Manager sees ALL except Ankit and Aarav
    action_vals['domain'] = ['|', ('user_id', '=', False), ('user_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]
else:
    # Standard salesperson sees ONLY their own records.
    action_vals['domain'] = [('user_id', '=', env.uid)]
 
action = action_vals
        ]]></field>
    </record>
 
    <menuitem id="menu_cfq_orders_procurement" name="Orders" parent="purchase.menu_purchase_root" action="action_dynamic_cfq_orders_procurement" sequence="-2" groups="contact_stage_bar.group_lgd_procurement,base.group_system"/>

    <!-- CANCELLATION WIZARD -->
    <record id="view_customer_rfq_cancel_wizard_form" model="ir.ui.view">
        <field name="name">customer.rfq.cancel.wizard.form</field>
        <field name="model">customer.rfq.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Customer RFQ">
                <field name="rfq_id" invisible="1"/>
                <group>
                    <field name="reason_ids" widget="many2many_tags"
                           options="{'no_quick_create': False}"
                           placeholder="Why is this quotation not going ahead?"/>
                    <field name="comment" placeholder="Add any detail worth keeping..."/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" type="object"
                            string="Cancel RFQ" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- CONFIGURATION: SHAPES -->
    <record id="view_customer_rfq_shape_list" model="ir.ui.view">
        <field name="name">customer.rfq.shape.list</field>
        <field name="model">customer.rfq.shape</field>
        <field name="arch" type="xml">
            <list string="Shapes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_customer_rfq_shape" model="ir.actions.act_window">
        <field name="name">Shapes</field>
        <field name="res_model">customer.rfq.shape</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a shape</p>
            <p>Shapes listed here are what Sales can pick on a Customer RFQ.</p>
        </field>
    </record>

    <!-- CONFIGURATION: CANCELLATION REASONS -->
    <record id="view_customer_rfq_cancel_reason_list" model="ir.ui.view">
        <field name="name">customer.rfq.cancel.reason.list</field>
        <field name="model">customer.rfq.cancel.reason</field>
        <field name="arch" type="xml">
            <list string="Cancellation Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_customer_rfq_cancel_reason" model="ir.actions.act_window">
        <field name="name">Cancellation Reasons</field>
        <field name="res_model">customer.rfq.cancel.reason</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a cancellation reason</p>
            <p>These are the tags offered when a Customer RFQ is cancelled.</p>
        </field>
    </record>

    <menuitem id="menu_customer_rfq_config" name="Configuration" parent="menu_sales_3"
              sequence="90" groups="base.group_system"/>
    <menuitem id="menu_customer_rfq_shape" name="Shapes" parent="menu_customer_rfq_config"
              action="action_customer_rfq_shape" sequence="10"
              groups="base.group_system"/>
    <menuitem id="menu_customer_rfq_cancel_reason" name="Cancellation Reasons"
              parent="menu_customer_rfq_config" action="action_customer_rfq_cancel_reason"
              sequence="20" groups="base.group_system"/>

</odoo>
