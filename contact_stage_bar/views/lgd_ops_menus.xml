<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ─────────────── Logistics ─────────────── -->
        <record id="menu_lgd_logistics_root" model="ir.ui.menu">
            <field name="name">Logistics</field>
            <field name="parent_id" eval="False"/>
            <field name="sequence">6</field>
            <field name="web_icon">contact_stage_bar,static/description/logistics_icon.png</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('contact_stage_bar.group_lgd_logistics'),
                ref('base.group_system')])]"/>
        </record>

        <menuitem id="menu_lgd_expected_stones"
                  name="Expected Stones"
                  parent="menu_lgd_logistics_root"
                  action="action_lgd_expected_stones"
                  sequence="1"/>

        <menuitem id="menu_lgd_handover_qc"
                  name="Hand over to QC"
                  parent="menu_lgd_logistics_root"
                  action="action_lgd_handover_qc"
                  sequence="2"/>

        <menuitem id="menu_lgd_returns_vendor"
                  name="Returns to Vendor"
                  parent="menu_lgd_logistics_root"
                  action="action_lgd_returns_vendor"
                  sequence="3"/>

        <menuitem id="menu_lgd_logistics_config"
                  name="Configuration"
                  parent="menu_lgd_logistics_root"
                  sequence="90"
                  groups="base.group_system"/>

        <menuitem id="menu_lgd_inward_reject_reason"
                  name="Inward Reject Reasons"
                  parent="menu_lgd_logistics_config"
                  action="action_lgd_inward_reject_reason"
                  sequence="1"
                  groups="base.group_system"/>

        <!-- ─────────────── Quality Control ─────────────── -->
        <record id="menu_lgd_qc_root" model="ir.ui.menu">
            <field name="name">Quality Control</field>
            <field name="parent_id" eval="False"/>
            <field name="sequence">7</field>
            <!-- Its own icon, so it is not mistaken for Sales in the app grid. -->
            <field name="web_icon">contact_stage_bar,static/description/quality_icon.png</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('contact_stage_bar.group_lgd_quality'),
                ref('base.group_system')])]"/>
        </record>

        <menuitem id="menu_lgd_qc_receive"
                  name="Receive from Logistics"
                  parent="menu_lgd_qc_root"
                  action="action_lgd_qc_receive"
                  sequence="1"/>

        <menuitem id="menu_lgd_qc_to_inspect"
                  name="To Inspect"
                  parent="menu_lgd_qc_root"
                  action="action_lgd_qc_to_inspect"
                  sequence="2"/>

        <menuitem id="menu_lgd_qc_config"
                  name="Configuration"
                  parent="menu_lgd_qc_root"
                  sequence="90"
                  groups="base.group_system"/>

        <menuitem id="menu_lgd_qc_fail_reason"
                  name="QC Fail Reasons"
                  parent="menu_lgd_qc_config"
                  action="action_lgd_qc_fail_reason"
                  sequence="1"
                  groups="base.group_system"/>

        <!-- ─────────────── Inventory Acceptance ─────────────── -->
        <menuitem id="menu_lgd_awaiting_acceptance"
                  name="Awaiting Acceptance"
                  parent="contact_stage_bar.menu_lgd_inventory"
                  action="action_lgd_awaiting_acceptance"
                  sequence="1"
                  groups="contact_stage_bar.group_lgd_inventory,base.group_system"/>

        <!-- ─────────────── Procurement Ready to Commit ─────────────── -->
        <menuitem id="menu_lgd_ready_to_commit"
                  name="Ready to Commit"
                  parent="purchase.menu_procurement_management"
                  action="action_lgd_ready_to_commit"
                  sequence="15"
                  groups="contact_stage_bar.group_lgd_procurement,base.group_system"/>

    </data>
</odoo>
