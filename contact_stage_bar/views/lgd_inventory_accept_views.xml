<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════
             INVENTORY -> AWAITING ACCEPTANCE
             Accept is the only step in the whole flow that moves stock, and
             the moment the stone becomes billable
             ═══════════════════════════════════════════════════════════════ -->
        <record id="view_lgd_awaiting_acceptance_list" model="ir.ui.view">
            <field name="name">lgd.awaiting.acceptance.list</field>
            <field name="model">purchase.order.line</field>
            <field name="arch" type="xml">
                <list string="Awaiting Acceptance" create="0" delete="0">
                    <header>
                        <button name="action_lgd_accept" type="object"
                                string="Accept" class="btn-primary"/>
                    </header>
                    <field name="lgd_invoice_number"/>
                    <field name="lgd_certificate"/>
                    <field name="lgd_shape"/>
                    <field name="lgd_carat"/>
                    <field name="lgd_colour"/>
                    <field name="lgd_clarity"/>
                    <field name="lgd_set_label"/>
                    <field name="lgd_set_incomplete" widget="boolean_toggle"/>
                    <field name="lgd_qc_decided_at"/>
                    <button name="action_lgd_accept" type="object"
                            string="Accept" class="btn-primary"/>
                </list>
            </field>
        </record>

        <record id="action_lgd_awaiting_acceptance" model="ir.actions.act_window">
            <field name="name">Awaiting Acceptance</field>
            <field name="res_model">purchase.order.line</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_lgd_awaiting_acceptance_list"/>
            <field name="search_view_id" ref="contact_stage_bar.view_lgd_ops_line_search"/>
            <field name="domain">[('lgd_stage', '=', 'qc_passed'), ('order_id.state', '=', 'purchase')]</field>
            <field name="context">{'group_by': 'lgd_invoice_number'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Nothing awaiting acceptance.</p>
                <p>Stones appear here once Procurement confirms their purchase order.</p>
            </field>
        </record>

    </data>
</odoo>
