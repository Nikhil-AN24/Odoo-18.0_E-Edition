<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Reject, Fail and Mark returned each capture a reason before anything is written. -->

        <record id="view_lgd_inward_reject_wizard_form" model="ir.ui.view">
            <field name="name">lgd.inward.reject.wizard.form</field>
            <field name="model">lgd.inward.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Stone">
                    <group>
                        <field name="line_ids" widget="many2many_tags"
                               readonly="1" options="{'no_open': True}"/>
                        <field name="reason_id" options="{'no_create': True}"/>
                        <field name="note" placeholder="Anything worth recording..."/>
                    </group>
                    <footer>
                        <button name="action_reject" type="object"
                                string="Reject" class="btn-danger"/>
                        <button string="Cancel" class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_lgd_qc_fail_wizard_form" model="ir.ui.view">
            <field name="name">lgd.qc.fail.wizard.form</field>
            <field name="model">lgd.qc.fail.wizard</field>
            <field name="arch" type="xml">
                <form string="Fail Stone">
                    <group>
                        <field name="line_ids" widget="many2many_tags"
                               readonly="1" options="{'no_open': True}"/>
                        <field name="reason_id" options="{'no_create': True}"/>
                        <field name="note" placeholder="Anything worth recording..."/>
                    </group>
                    <footer>
                        <button name="action_fail" type="object"
                                string="Fail" class="btn-danger"/>
                        <button string="Cancel" class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_lgd_vendor_return_wizard_form" model="ir.ui.view">
            <field name="name">lgd.vendor.return.wizard.form</field>
            <field name="model">lgd.vendor.return.wizard</field>
            <field name="arch" type="xml">
                <form string="Mark Returned to Vendor">
                    <group>
                        <field name="line_ids" widget="many2many_tags"
                               readonly="1" options="{'no_open': True}"/>
                        <field name="method" widget="radio"/>
                        <field name="returned_by_id"/>
                        <field name="proof" filename="proof_filename"
                               string="Signed Slip (optional)"/>
                        <field name="proof_filename" invisible="1"/>
                        <field name="note" placeholder="Anything worth recording..."/>
                    </group>
                    <footer>
                        <button name="action_mark_returned" type="object"
                                string="Mark returned" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
