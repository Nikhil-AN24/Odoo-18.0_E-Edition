    <record id="action_contacts_custom_all_sysadmin" model="ir.actions.act_window">
        <field name="name">All Accounts (Admin)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True,'search_default_type_company': 1}</field>
        <field name="domain">[]</field>
    </record>

    <record id="action_contacts_custom_sysadmin" model="ir.actions.act_window">
        <field name="name">Accounts India (Admin)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True,'search_default_type_company': 1}</field>
        <field name="domain">[('country_id', '=', 104), ('country_id', '!=', False)]</field>
    </record>

    <record id="action_contacts_custom_usa_sysadmin" model="ir.actions.act_window">
        <field name="name">Accounts International (Admin)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True,'search_default_type_company': 1}</field>
        <field name="domain">[('country_id', '!=', 104), ('country_id', '!=', False)]</field>
    </record>

    <menuitem id="res_partner_menu_contacts_all_mine" name="My Accounts" action="contact_stage_bar.action_contacts_custom_all_mine" parent="contacts.menu_contacts" sequence="1" groups="contact_stage_bar.group_lgd_sales"/>
    <menuitem id="contacts.res_partner_menu_contacts" name="Accounts India (My)" action="contacts.action_contacts" parent="contacts.menu_contacts" sequence="2" groups="contact_stage_bar.group_lgd_sales"/>
    <menuitem id="res_partner_menu_contacts_custom_usa" name="Accounts International (My)" action="contact_stage_bar.action_contacts_custom_usa" parent="contacts.menu_contacts" sequence="3" groups="contact_stage_bar.group_lgd_sales"/>

    <menuitem id="res_partner_menu_contacts_all" name="All Accounts" action="contact_stage_bar.action_contacts_custom_all" parent="contacts.menu_contacts" sequence="4" groups="contact_stage_bar.group_lgd_sales_manager"/>
    <menuitem id="res_partner_menu_contacts_custom" name="Accounts India (All)" action="contact_stage_bar.action_contacts_custom" parent="contacts.menu_contacts" sequence="5" groups="contact_stage_bar.group_lgd_sales_manager"/>
    <menuitem id="res_partner_menu_contacts_custom_usa_admin" name="Accounts International (All)" action="contact_stage_bar.action_contacts_custom_usa_admin" parent="contacts.menu_contacts" sequence="6" groups="contact_stage_bar.group_lgd_sales_manager"/>

    <menuitem id="res_partner_menu_contacts_all_sysadmin" name="All Accounts" action="contact_stage_bar.action_contacts_custom_all_sysadmin" parent="contacts.menu_contacts" sequence="4" groups="base.group_system"/>
    <menuitem id="res_partner_menu_contacts_custom_sysadmin" name="Accounts India (All)" action="contact_stage_bar.action_contacts_custom_sysadmin" parent="contacts.menu_contacts" sequence="5" groups="base.group_system"/>
    <menuitem id="res_partner_menu_contacts_custom_usa_sysadmin" name="Accounts International (All)" action="contact_stage_bar.action_contacts_custom_usa_sysadmin" parent="contacts.menu_contacts" sequence="6" groups="base.group_system"/>

    <record id="res_partner_kanban_inherit_groupby_status" model="ir.ui.view">
        <field name="name">res.partner.kanban.inherit.groupby.status</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">stage_id</attribute>
            </xpath>
            <xpath expr="//kanban" position="inside">
                <field name="stage_id" group_expand="stage_id"/>
                <field name="lead_source"/>
                <field name="graduation_rate" widget="priority" options="{'max': 4}" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_kanban_lead_grad_fields" model="ir.ui.view">
        <field name="name">res.partner.kanban.lead.grad.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']" position="inside">
                <div class="d-flex flex-column mt-1">
                    <div t-if="record.lead_source.value">
                        <strong>Lead Source:</strong>
                        <t t-esc="record.lead_source.value"/>
                    </div>
                    <div>
                        <strong>Graduation Rate:</strong>
                        <field name="graduation_rate" widget="priority" options="{'max': 4}" readonly="1"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>