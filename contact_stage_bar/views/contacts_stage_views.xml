<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the form view of contacts to add status bar -->
    <record id="view_partner_form_inherit_stage" model="ir.ui.view">
        <field name="name">res.partner.form.stagebar</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <!-- statusbar_visible="open,contacted,registered,converted" -->
            </xpath>
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//span[@name='address_name']/span" position="replace">
                <span invisible="not is_company">Billing Address</span>
            </xpath>
            <xpath expr="//field[@name='name'][1]" position="attributes">
                <attribute name="placeholder">e.g. Anirath Overseas</attribute>
            </xpath>
            <xpath expr="//group[1]" position="after">
                <group>
                    <group>
                        <field name="ein_number"/>
                        <field name="gst_stages"/>
                        <field name="ein_status"/>
                    </group>
                    <group></group>
                </group>
            </xpath>
            <xpath expr="//group[2]/field[@name='function']" position="after">
                <field name="first_name" invisible="not id"/>
                <field name="last_name" invisible="not id"/>
                <field name="contact_person_name"/>
                <field name="job_position"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="primary_category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="user_id"/>
                <field name="lead_source"/>
                <field name="graduation_rate" widget="priority"/>
                <field name="shipping_address_differs"/>
                <field name="shipping_address" readonly="not shipping_address_differs"/>
                <field name="terms"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="/form" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Move "Accounts" inside "Sales" as a submenu.
         parent_id = sale.sale_menu_root sequence=20 places it after "Orders" in the nav bar -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="name">Accounts</field>
        <field name="parent_id" ref="sale.sale_menu_root"/>
        <field name="sequence">20</field>
    </record>

    <record id="action_contacts_custom_all_mine" model="ir.actions.act_window">
        <field name="name">My Accounts</field>
        <field name="path">contacts_all_mine</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True,'search_default_type_company': 1}</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="name">Accounts India (My)</field>
        <field name="domain">[('user_id', '=', uid), ('country_id', '=', 104)]</field>
        <field name="context">{'default_is_company': True,'search_default_type_company': 1}</field>
    </record>

    <record id="action_contacts_custom_usa" model="ir.actions.act_window">
        <field name="name">Accounts International (My)</field>
        <field name="path">contacts_usa</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True,'search_default_type_company': 1}</field>
        <field name="domain">[('user_id', '=', uid), ('country_id', '!=', 104), ('country_id', '!=', False)]</field>
    </record>

    <record id="action_contacts_custom_all" model="ir.actions.act_window">
        <field name="name">All Accounts</field>
        <field name="path">contacts_all</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True,'search_default_type_company': 1}</field>
        <field name="domain">['|', ('user_id', '=', False), ('user_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]</field>
    </record>

    <record id="action_contacts_custom" model="ir.actions.act_window">
        <field name="name">Accounts India (All)</field>
        <field name="path">contacts_1</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True,'search_default_type_company': 1}</field>
        <field name="domain">[('country_id', '=', 104), ('country_id', '!=', False), '|', ('user_id', '=', False), ('user_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]</field>
    </record>

    <record id="action_contacts_custom_usa_admin" model="ir.actions.act_window">
        <field name="name">Accounts International (All)</field>
        <field name="path">contacts_usa_admin</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True,'search_default_type_company': 1}</field>
        <field name="domain">[('country_id', '!=', 104), ('country_id', '!=', False), '|', ('user_id', '=', False), ('user_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]</field>
