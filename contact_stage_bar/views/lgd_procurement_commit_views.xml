<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════
             PROCUREMENT -> READY TO COMMIT
             The negotiation window made visible: everything here is checked,
             in the building, and not yet bought.
             ═══════════════════════════════════════════════════════════════ -->
        <record id="view_lgd_ready_to_commit_list" model="ir.ui.view">
            <field name="name">lgd.ready.to.commit.list</field>
            <field name="model">purchase.order.line</field>
            <field name="arch" type="xml">
                <list string="Ready to Commit" create="0" delete="0"
                      decoration-danger="lgd_is_overdue">
                    <header>
                        <button name="action_lgd_confirm_ready_stones"
                                type="object" string="Confirm ready stones"
                                class="btn-primary"
                                groups="contact_stage_bar.group_lgd_procurement,base.group_system"/>
                    </header>
                    <field name="lgd_is_overdue" column_invisible="1"/>
                    <field name="lgd_invoice_number"/>
                    <field name="lgd_certificate"/>
                    <field name="lgd_shape"/>
                    <field name="lgd_carat"/>
                    <field name="lgd_colour"/>
                    <field name="lgd_clarity"/>
                    <field name="lgd_qc_decided_at"/>
                    <field name="lgd_commit_deadline"/>
                </list>
            </field>
        </record>

        <record id="action_lgd_ready_to_commit" model="ir.actions.act_window">
            <field name="name">Ready to Commit</field>
            <field name="res_model">purchase.order.line</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_lgd_ready_to_commit_list"/>
            <field name="search_view_id" ref="contact_stage_bar.view_lgd_ops_line_search"/>
            <field name="domain">[('lgd_stage', '=', 'qc_passed'), ('order_id.state', 'in', ('draft', 'sent'))]</field>
            <field name="context">{'group_by': 'order_id'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Nothing waiting to commit.</p>
                <p>Stones that pass QC appear here until you confirm their purchase order.</p>
            </field>
        </record>

        <!-- The same action from the purchase order form, plus the
             "Returned — do not pay" ribbon from -->
        <record id="view_lgd_purchase_order_form" model="ir.ui.view">
            <field name="name">purchase.order.form.lgd.ops</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <field name="lgd_po_voided" invisible="1"/>
                </xpath>
                <xpath expr="//div[hasclass('oe_title')]" position="before">
                    <widget name="web_ribbon" title="Returned — do not pay"
                            bg_color="text-bg-danger"
                            invisible="not lgd_po_voided"/>
                </xpath>
                <xpath expr="//button[@name='button_confirm']" position="before">
                    <button name="action_lgd_confirm_ready_stones" type="object"
                            string="Confirm ready stones" class="btn-primary"
                            invisible="state not in ('draft', 'sent')"
                            groups="contact_stage_bar.group_lgd_procurement,base.group_system"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
