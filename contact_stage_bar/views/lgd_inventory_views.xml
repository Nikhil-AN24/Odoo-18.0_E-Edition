<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_lgd_inventory_line_search" model="ir.ui.view">
            <field name="name">lgd.inventory.line.search</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <search string="Stones">
                    <field name="lgd_invoice_number" string="Invoice Number"/>
                    <field name="certificate" string="Certificate"/>
                    <filter name="lgd_vendor_memo" string="On Vendor Memo"
                            domain="[('lgd_vendor_memo', '=', True)]"/>
                    <filter name="lgd_owned" string="Owned by us"
                            domain="[('lgd_vendor_memo', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="lgd_group_invoice" string="Invoice Number"
                                context="{'group_by': 'lgd_invoice_number'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ─────────────── In Vault ─────────────── -->
        <record id="view_lgd_in_vault_list" model="ir.ui.view">
            <field name="name">lgd.in.vault.list</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <list string="In Vault" create="0" delete="0"
                      decoration-muted="lgd_set_incomplete"
                      decoration-info="lgd_vendor_memo">
                    <header>
                        <button name="action_lgd_hand_to_dispatch" type="object"
                                string="Handed to Dispatch" class="btn-primary"/>
                    </header>

                    <field name="lgd_invoice_number" string="Invoice Number"/>
                    <field name="certificate" string="Certificate"/>
                    <field name="shapes" string="Shape"/>
                    <field name="carat_weight" string="Carat"/>
                    <field name="color" string="Colour"/>
                    <field name="clarity" string="Clarity"/>
                    <field name="lgd_inr_currency_id" column_invisible="1"/>
                    <field name="lgd_po_total" string="Pricing" widget="monetary"
                           options="{'currency_field': 'lgd_inr_currency_id'}"/>
                    <field name="lgd_set_label" string="Set Label"/>
                    <field name="lgd_qc_decided_at" string="QC Decided On"/>
                    <field name="lgd_set_incomplete" column_invisible="1"/>
                    <field name="lgd_vault_by" string="Vaulted By"/>
                    <field name="lgd_vault_at" string="Vaulted On"/>
                    <field name="lgd_vendor_memo" string="On Memo"
                           widget="boolean_toggle" readonly="1"/>
                    <button name="action_lgd_hand_to_dispatch" type="object"
                            string="Handed to Dispatch" class="btn-link"/>
                </list>
            </field>
        </record>

        <record id="action_lgd_in_vault" model="ir.actions.act_window">
            <field name="name">In Vault</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_lgd_in_vault_list"/>
            <field name="search_view_id" ref="view_lgd_inventory_line_search"/>
            <field name="domain">[('lgd_in_vault', '=', True), ('lgd_to_dispatch', '=', False)]</field>
            <field name="context">{'group_by': 'lgd_invoice_number'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">The vault is empty.</p>
                <p>Tick a stone as placed in the vault and it appears here.</p>
            </field>
        </record>

        <menuitem id="menu_lgd_in_vault"
                  name="In Vault"
                  parent="contact_stage_bar.menu_lgd_inventory"
                  action="action_lgd_in_vault"
                  sequence="3"
                  groups="contact_stage_bar.group_lgd_inventory,base.group_system"/>
    </data>
</odoo>