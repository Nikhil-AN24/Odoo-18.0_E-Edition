<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">payment.confirmation.wizard.form</field>
        <field name="model">payment.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Payment Confirmation">
                <sheet>
                    <group>
                        <!--<separator string="Payment Confirmation" colspan="2"/>-->
                        <field name="utr_number" placeholder="Enter UTR Number" required="1"/>
                        <separator string="Is Payment Process Completed?" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_yes" string="Yes" type="object" class="btn-primary"/>
                    <button name="action_confirm_no" string="No" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payment_confirmation_wizard" model="ir.actions.act_window">
        <field name="name">Payment Confirmation</field>
        <field name="res_model">payment.confirmation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
