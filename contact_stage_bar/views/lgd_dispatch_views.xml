<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════ READY TO DISPATCH (sale.order.line) ═══════════ -->
        <record id="view_lgd_ready_to_dispatch_list" model="ir.ui.view">
            <field name="name">lgd.ready.to.dispatch.list</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <list string="Ready to Dispatch" create="0" delete="0"
                      decoration-muted="lgd_set_incomplete">
                    <header>
                        <button name="action_lgd_make_parcels" type="object"
                                string="Make parcels" class="btn-primary"/>
                    </header>
                    <field name="lgd_invoice_number" string="Invoice Number"/>
                    <field name="certificate" string="Certificate"/>
                    <field name="lgd_ship_label" string="Destination"/>
                    <field name="shapes" string="Shape"/>
                    <field name="carat_weight" string="Carat"/>
                    <field name="color" string="Colour"/>
                    <field name="clarity" string="Clarity"/>
                    <field name="lgd_set_incomplete" string="Set Incomplete"
                           widget="boolean_toggle" readonly="1"/>
                    <field name="availability_status" string="Availability"/>
                    <field name="lgd_vendor_memo" string="On Memo"
                           widget="boolean_toggle" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="action_lgd_ready_to_dispatch" model="ir.actions.act_window">
            <field name="name">Ready to Dispatch</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_lgd_ready_to_dispatch_list"/>
            <field name="domain">[('lgd_ready_to_dispatch', '=', True)]</field>
            <field name="context">{'group_by': 'lgd_ship_label'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Nothing ready to dispatch.</p>
                <p>Hand a stone to Dispatch from In Vault and it appears here.</p>
            </field>
        </record>

        <!-- ═══════════════════ PARCELS ═══════════════════ -->
        <record id="view_lgd_dispatch_list" model="ir.ui.view">
            <field name="name">lgd.dispatch.list</field>
            <field name="model">lgd.dispatch</field>
            <field name="arch" type="xml">
                <list string="Parcels" create="0" delete="0"
                      decoration-danger="follow_up_count &gt; 3 or memo_overdue"
                      decoration-warning="approval_state == 'pending'"
                      decoration-info="dispatch_type == 'memo'">
                    <field name="name"/>
                    <field name="dispatch_type"/>
                    <field name="invoice_number"/>
                    <field name="stone_count"/>
                    <field name="route"/>
                    <field name="agent_id"/>
                    <field name="state"/>
                    <field name="approval_state"/>
                    <field name="memo_due_date"/>
                    <field name="handed_over_at"/>
                    <field name="follow_up_count"/>
                    <field name="memo_overdue" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_lgd_dispatch_form" model="ir.ui.view">
            <field name="name">lgd.dispatch.form</field>
            <field name="model">lgd.dispatch</field>
            <field name="arch" type="xml">
                <form string="Parcel" create="0" delete="0">
                    <header>
                        <button name="action_lgd_print_label" type="object"
                                string="Print label" class="btn-secondary"/>
                        <button name="action_lgd_print_memo_slip" type="object"
                                string="Print memo slip" class="btn-secondary"
                                invisible="not lgd_is_memo_doc"/>
                        <button name="action_lgd_print_invoice_slip" type="object"
                                string="Print invoice slip" class="btn-secondary"
                                invisible="dispatch_type != 'sale'"/>
                        <button name="action_lgd_confirm_delivery" type="object"
                                string="Delivered" class="btn-primary"
                                invisible="state != 'handed_over'"/>
                        <button name="action_lgd_return_of_order" type="object"
                                string="Return of Order" class="btn-warning"
                                invisible="state not in ('handed_over', 'delivered')"/>
                        <button name="action_lgd_re_dispatch" type="object"
                                string="Re - Dispatched" class="btn-secondary"
                                invisible="not lgd_has_returned_lines"/>
                        <button name="action_lgd_complete_order" type="object"
                                string="Complete order" class="btn-primary"
                                invisible="state != 'delivered'"/>
                        <field name="lgd_has_returned_lines" invisible="1"/>
                        <button name="action_lgd_hand_over" type="object"
                                string="Handed over" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_lgd_open_split_wizard" type="object"
                                string="Split" class="btn-secondary"
                                invisible="state != 'draft'"/>
                        <!-- Only a memo parcel that has actually
                             left has a return to record. -->
                        <button name="action_lgd_open_memo_return" type="object"
                                string="Record memo return" class="btn-primary"
                                invisible="dispatch_type != 'memo' or state not in ('handed_over', 'delivered')"/>
                        <button name="action_lgd_cancel" type="object"
                                string="Cancel" class="btn-secondary"
                                invisible="state != 'draft'"/>
                        <button name="action_lgd_approve_partial" type="object"
                                string="Approve partial" class="btn-success"
                                invisible="approval_state != 'pending'"/>
                        <button name="action_lgd_refuse_partial" type="object"
                                string="Refuse partial" class="btn-danger"
                                invisible="approval_state != 'pending'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,handed_over,delivered"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                            <!-- Shown only for a multi-parcel batch, where
                                 it tells the packer which box this is. A
                                 single parcel rendered a bare "1 of 1",
                                 which carried no information. -->
                            <h3>
                                <field name="lgd_parcel_position_label"
                                       readonly="1" nolabel="1"/>
                            </h3>
                        </div>
                        <group>
                            <group string="Deliver to">
                                <field name="lgd_buyer_name" readonly="1"/>
                                <field name="ship_label" readonly="1"/>
                                <field name="ship_name" readonly="1"/>
                                <field name="invoice_number" readonly="1"/>
                                <field name="stone_count" readonly="1"/>
                            </group>
                            <group string="Carrier">
                                <field name="route"/>
                                <field name="agent_id"
                                       domain="[('agent_type', '=', route)]"
                                       options="{'no_create': True}"/>
                                <field name="estimated_delivery_date"/>
                                <field name="tracking_number"/>
                                <field name="tracking_url"/>
                                <field name="upload_slip_filename" invisible="1"/>
                                <field name="upload_slip" widget="binary"
                                       filename="upload_slip_filename"/>
                            </group>
                        </group>
                        <group>
                            <group string="Type">
                                <field name="dispatch_type"
                                       readonly="state != 'draft'"/>
                                <field name="lgd_is_memo_doc" invisible="1"/>
                                <field name="memo_due_date"
                                       invisible="not lgd_is_memo_doc"
                                       required="dispatch_type == 'memo'"/>
                            </group>
                            <group string="Checks">
                                <field name="label_printed" readonly="1"/>
                                <field name="invoice_slip_printed" readonly="1"
                                       invisible="dispatch_type != 'sale'"/>
                                <field name="memo_slip_printed" readonly="1"
                                       invisible="not lgd_is_memo_doc"/>
                                <field name="invoice_enclosed"
                                       invisible="dispatch_type != 'sale'"/>
                                <field name="memo_enclosed"
                                       invisible="not lgd_is_memo_doc"/>
                            </group>
                        </group>
                        <group string="Partial dispatch"
                               invisible="approval_state == 'not_required'">
                            <field name="partial_reason"
                                   required="approval_state == 'pending'"/>
                            <field name="approval_state" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Stones" name="stones">
                                <field name="line_ids" readonly="1">
                                    <list create="0" delete="0">
                                        <field name="availability_status"/>
                                        <field name="shapes"/>
                                        <field name="certificate"/>
                                        <field name="carat_weight"/>
                                        <field name="color"/>
                                        <field name="clarity"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Follow-up" name="followup"
                                  invisible="state == 'draft'">
                                <group>
                                    <group>
                                        <field name="handed_over_by" readonly="1"/>
                                        <field name="handed_over_at" readonly="1"/>
                                        <field name="follow_up_count" readonly="1"/>
                                        <field name="last_follow_up_on" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="delivery_confirmed_by" readonly="1"/>
                                        <field name="delivery_confirmed_at" readonly="1"/>
                                        <field name="delivery_note"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_lgd_parcels" model="ir.actions.act_window">
            <field name="name">Parcels</field>
            <field name="res_model">lgd.dispatch</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', 'in', ('draft', 'handed_over'))]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No parcels yet.</p>
                <p>Select stones on Ready to Dispatch and press Make parcels.</p>
            </field>
        </record>

        <!-- ═══ SHARED LIST + SEARCH for the two handed-over menus ═══ -->
        <record id="view_lgd_dispatch_handed_list" model="ir.ui.view">
            <field name="name">lgd.dispatch.handed.list</field>
            <field name="model">lgd.dispatch</field>
            <field name="arch" type="xml">
                <list string="Parcels" create="0" delete="0" edit="0"
                      default_order="handed_over_at desc"
                      decoration-success="state == 'delivered'"
                      decoration-muted="state == 'cancelled'"
                      decoration-danger="memo_overdue">
                    <field name="name"/>
                    <field name="dispatch_type"/>
                    <field name="invoice_number"/>
                    <field name="stone_count"/>
                    <field name="agent_id"/>
                    <field name="tracking_number" optional="show"/>
                    <field name="handed_over_at"/>
                    <field name="handed_over_by" optional="show"/>
                    <field name="memo_due_date" optional="show"/>
                    <!-- How many of the memo's stones already have
                         an outcome, so a half-decided memo is visible. -->
                    <field name="lgd_memo_decided_count" optional="show"/>
                    <field name="lgd_memo_undecided_count" optional="hide"/>
                    <field name="delivery_confirmed_at"/>
                    <field name="delivery_confirmed_by" optional="show"/>
                    <field name="follow_up_count" optional="hide"/>
                    <field name="delivery_note" optional="hide"/>
                    <field name="state"/>
                    <field name="memo_overdue" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_lgd_dispatch_handed_search" model="ir.ui.view">
            <field name="name">lgd.dispatch.handed.search</field>
            <field name="model">lgd.dispatch</field>
            <field name="arch" type="xml">
                <search string="Parcels">
                    <field name="name"/>
                    <field name="invoice_number"/>
                    <field name="tracking_number"/>
                    <field name="agent_id"/>
                    <filter name="still_out" string="Still Out"
                            domain="[('state', '=', 'handed_over')]"/>
                    <filter name="closed" string="Confirmed"
                            domain="[('state', '=', 'delivered')]"/>
                    <separator/>
                    <filter name="overdue_memo" string="Overdue Memo"
                            domain="[('memo_overdue', '=', True)]"/>
                    <separator/>
                    <filter name="handed_over_month" string="Handed Over"
                            date="handed_over_at"/>
                    <group expand="0" string="Group By">
                        <filter name="group_state" string="State"
                                context="{'group_by': 'state'}"/>
                        <filter name="group_agent" string="Carrier"
                                context="{'group_by': 'agent_id'}"/>
                        <filter name="group_handed_over" string="Handed Over"
                                context="{'group_by': 'handed_over_at:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ═══════ AWAITING DELIVERY CONFIRMATION ═══════ -->
        <record id="action_lgd_awaiting_delivery" model="ir.actions.act_window">
            <field name="name">Awaiting Delivery Confirmation</field>
            <field name="res_model">lgd.dispatch</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_lgd_dispatch_handed_list"/>
            <field name="search_view_id" ref="view_lgd_dispatch_handed_search"/>

            <field name="domain">[('dispatch_type', '=', 'sale'), ('handed_over_at', '!=', False), ('state', '!=', 'memo_closed')]</field>
            <field name="context">{'search_default_still_out': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Nothing awaiting confirmation.</p>
                <p>Remove the "Still Out" filter to see every parcel ever handed over.</p>
            </field>
        </record>

        <!-- ═══════════════ MEMOS OUT ═══════════════ -->
        <record id="action_lgd_memos_out" model="ir.actions.act_window">
            <field name="name">Memos Out</field>
            <field name="res_model">lgd.dispatch</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_lgd_dispatch_handed_list"/>
            <field name="search_view_id" ref="view_lgd_dispatch_handed_search"/>
            <field name="domain">['|', ('dispatch_type', '=', 'memo'), ('state', '=', 'memo_closed'), ('handed_over_at', '!=', False)]</field>
            <field name="context">{'search_default_still_out': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No memos are out.</p>
                <p>This is what is with clients right now, and what is overdue.
                   Remove the "Still Out" filter to see every memo ever sent.</p>
            </field>
        </record>

        <!-- ═══════ COURIERS ═══════ -->
        <record id="view_lgd_courier_agent_list" model="ir.ui.view">
            <field name="name">lgd.courier.agent.list</field>
            <field name="model">lgd.courier.agent</field>
            <field name="arch" type="xml">
                <list string="Couriers" editable="bottom">
                    <field name="firm_name" string="Firm Name"/>
                    <field name="name" string="Contact Name"/>
                    <field name="phone"/>
                    <field name="city"/>
                    <field name="note" optional="hide"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_lgd_courier_agent_form" model="ir.ui.view">
            <field name="name">lgd.courier.agent.form</field>
            <field name="model">lgd.courier.agent</field>
            <field name="arch" type="xml">
                <form string="Courier">
                    <sheet>
                        <group>
                            <group>
                                <!-- Firm first, then the person at that firm. -->
                                <field name="firm_name" string="Firm Name"/>
                                <field name="name" string="Contact Name"/>
                                <field name="city"/>
                                <field name="note"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="phone"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_lgd_courier_agent" model="ir.actions.act_window">
            <field name="name">Couriers</field>
            <field name="res_model">lgd.courier.agent</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No carriers yet.</p>
                <p>Add the couriers Dispatch hands parcels to.</p>
            </field>
        </record>
    </data>
</odoo>