<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Window Action for LGD Inventory -->
    <record id="action_lgd_inventory_picking" model="ir.actions.act_window">
        <field name="name">Inventory Location</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('picking_type_id', 'in', [12, 13]),
            ('location_id', '=', 10)
        ]</field>
        <field name="context">{
            'search_default_ready': 1,
            'search_default_group_by_origin': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No LGD Inventory transfers found
            </p>
            <p>
                LGD Inventory transfers are created automatically after Quality Check validation.
                <br/>
                Search by:
                <ul>
                    <li>PO Number (e.g., P00140)</li>
                    <li>Reference (e.g., AUG/INV/00127)</li>
                    <li>Remove the "Ready" filter to see all records</li>
                </ul>
            </p>
        </field>
    </record>

    <!-- Menu Item for LGD Inventory -->
    <menuitem
        id="menu_lgd_inventory"
        name="LGD Inventory"
        parent="stock.menu_stock_root"
        action="action_lgd_inventory_picking"
        sequence="20"/>
</odoo>
