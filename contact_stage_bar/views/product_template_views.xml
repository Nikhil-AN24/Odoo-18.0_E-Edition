<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_product_template_form_custom" model="ir.ui.view">
            <field name="name">product.template.form.custom</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//button[@name='action_open_label_layout']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//header" position="inside">
                    <button name="action_fetch_certificate_data"
                                    type="object"
                                    string="Fetch Certificate Data"
                                    class="btn-primary"
                                    invisible="sdk_is_code_enabled"/>
                                    </xpath>
                <xpath expr="//label[@for='name']" position="before">
                    <field name="is_non_certified_source" invisible="1"/>
                    <div invisible="is_non_certified_source">
                        <h1>
                            <label for="certificate" string="Certificate Number"/>
                            <field name="certificate"/>
                        </h1>
                        <div class="mb-2">
                            <!-- Visible unless the record is explicitly marked as a
                                 non-IGI lab; the Python action also raises a clear
                                 UserError if certificate is empty or lab isn't IGI. -->
                            <button name="action_fetch_igi_data"
                                    type="object"
                                    string="Fetch from IGI"
                                    class="btn-primary"
                                    invisible="lab_id not in (False, 'igi')"/>
                        </div>
                    </div>
                </xpath>
                <xpath expr="//group[@name='group_general']" position="inside">
                    <field name="lab_id"/>
                    <field name="labs"/>
                    <field name="lgd_stock_number"/>
                    <field name="stock_number"/>
                    <field name="certificate_type" groups="!contact_stage_bar.group_lgd_procurement"/>
                    <field name="website_product_id" readonly="1"/>
                    <field name="url_link" readonly="1" widget="url"/>
     
                    <field name="shapes"/>
                    <field name="weight_carat"/>
                    <field name="clarity"/>
                    <field name="color"/>
                    <field name="luster"/>
                    <field name="shade"/>
                    <field name="fluorescence_color"/>
                    <field name="fluorescence_intensity"/>
                </xpath>

                <xpath expr="//field[@name='l10n_in_hsn_code']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='l10n_in_hsn_code']" position="after">
                    <field name="measurements"/>
                    <field name="length"/>
                    <field name="width"/>
                    <field name="depth"/>
                    <field name="eye_clean"/>
  
                    <field name="polish"/>
                    <field name="cut"/>
                    <field name="symmetry"/>
                    <field name="treatments"/>
                    <field name="video_360" readonly="1" widget="url"/>
                    <field name="image_augmont" readonly="1" widget="url"/>
                    <field name="country_id"/>
                    <field name="order_specific"/>
                    <field name="item_notes" widget="text" placeholder="Enter general order notes..." style="height:80px; white-space:normal;"/>
                    <field name="customer_reference_note" widget="text" placeholder="Enter Custom Reference notes..." style="height:40px; white-space:normal;"/>
                    <field name="default_qc_requirements"/>
                </xpath>

                <xpath expr="//label[@for='list_price']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>

                <xpath expr="//div[@name='list_price_uom']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>

                <xpath expr="//field[@name='list_price']" position="attributes">
                    <attribute name="string">Final Price Per Carat</attribute>
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>

                <xpath expr="//div[@name='list_price_uom']" position="after">
                    <field name="final_price_margin" string="Final Price" groups="!contact_stage_bar.group_lgd_procurement"/>
                    <field name="price_per_carat" string="Vendor Price Per Carat" groups="!contact_stage_bar.group_lgd_sales"/>
                    <field name="final_price" string="Vendor Final Price" groups="!contact_stage_bar.group_lgd_sales"/>
                </xpath>   

                <xpath expr="//field[@name='taxes_id']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_sales</attribute>
                </xpath>

                <xpath expr="//field[@name='tax_string']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_sales</attribute>
                </xpath>

                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_sales</attribute>
                </xpath>

                <!-- Purchase: only Procurement groups + Admin. -->
                <xpath expr="//page[@name='purchase']" position="attributes">
                    <attribute name="groups">contact_stage_bar.group_lgd_procurement,contact_stage_bar.group_lgd_procurement_manager,base.group_system</attribute>
                </xpath>
                <!-- Sales: only Sales groups + Admin. -->
                <xpath expr="//page[@name='sales']" position="attributes">
                    <attribute name="groups">contact_stage_bar.group_lgd_sales,contact_stage_bar.group_lgd_regional_sales_head,contact_stage_bar.group_lgd_sales_manager,base.group_system</attribute>
                </xpath>

                <!-- Expose is_readonly_for_sales_view so the General Info
                     page can bind readonly= to it (only sales roles → True). -->
                <xpath expr="//page[@name='general_information']" position="before">
                    <field name="is_readonly_for_sales_view" invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='type']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='combo_ids']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='service_tracking']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='list_price']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>

                <xpath expr="//field[@name='categ_id']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='company_id']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='description']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='lab_id']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='labs']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='lgd_stock_number']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='stock_number']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='certificate_type']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='shapes']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='weight_carat']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='clarity']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='color']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='luster']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='shade']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='fluorescence_color']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='fluorescence_intensity']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='measurements']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='length']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='width']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='depth']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='eye_clean']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='polish']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='cut']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='symmetry']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='treatments']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='country_id']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='order_specific']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='item_notes']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='customer_reference_note']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='default_qc_requirements']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='final_price_margin']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_policy']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='is_storable']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_supplierinfo_tree_inherit" model="ir.ui.view">
            <field name="name">product.supplierinfo.list.inherit</field>
            <field name="model">product.supplierinfo</field>
            <field name="inherit_id" ref="purchase.product_supplierinfo_tree_view2"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="vendor_final_price"/>
                    <field name="vendor_per_carat_price"/>
                </xpath>
                <!-- Hide the Price column for LGD Procurement users.  -->
                <xpath expr="//field[@name='price']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_only_form_hide_procurement" model="ir.ui.view">
            <field name="name">product.template.only.form.hide.procurement</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <!-- Sales tab: only Sales groups + Admin. -->
                <xpath expr="//page[@name='sales']" position="attributes">
                    <attribute name="groups">contact_stage_bar.group_lgd_sales,contact_stage_bar.group_lgd_regional_sales_head,contact_stage_bar.group_lgd_sales_manager,base.group_system</attribute>
                </xpath>
                <!-- Purchase tab: only Procurement groups + Admin. -->
                <xpath expr="//page[@name='purchase']" position="attributes">
                    <attribute name="groups">contact_stage_bar.group_lgd_procurement,contact_stage_bar.group_lgd_procurement_manager,base.group_system</attribute>
                </xpath>
                <!-- Attributes & Variants: Admin only. -->
                <xpath expr="//page[@name='variants']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
                <!-- General Info: readonly for LGD Sales roles. -->
                <xpath expr="//page[@name='general_information']" position="before">
                    <field name="is_readonly_for_sales_view" invisible="1"/>
                </xpath>

                <xpath expr="//page[@name='general_information']/group" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <!-- hide the Sales/Purchase checkboxes near the product
                     name, the "Product Type" radio (Goods/Service/Combo),
                     and "Cost" for LGD Procurement. -->
                <xpath expr="//field[@name='sale_ok']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>
                <xpath expr="//field[@name='purchase_ok']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement,!contact_stage_bar.group_lgd_sales,!contact_stage_bar.group_lgd_regional_sales_head,!contact_stage_bar.group_lgd_sales_manager</attribute>
                </xpath>
                <xpath expr="//field[@name='type']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>
                <xpath expr="//field[@name='is_storable']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>

                <xpath expr="//field[@name='default_code']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
                <xpath expr="//field[@name='barcode']" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_product_normal_form_hide_procurement" model="ir.ui.view">
            <field name="name">product.normal.form.hide.procurement</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_fetch_certificate_data']" position="replace"/>

                <!-- Sales tab: only Sales groups + Admin. -->
                <xpath expr="//page[@name='sales']" position="attributes">
                    <attribute name="groups">contact_stage_bar.group_lgd_sales,contact_stage_bar.group_lgd_regional_sales_head,contact_stage_bar.group_lgd_sales_manager,base.group_system</attribute>
                </xpath>
                <!-- Purchase tab: only Procurement groups + Admin. -->
                <xpath expr="//page[@name='purchase']" position="attributes">
                    <attribute name="groups">contact_stage_bar.group_lgd_procurement,contact_stage_bar.group_lgd_procurement_manager,base.group_system</attribute>
                </xpath>

                <!-- General Info: readonly for LGD Sales roles. -->
                <xpath expr="//page[@name='general_information']" position="before">
                    <field name="is_readonly_for_sales_view" invisible="1"/>
                </xpath>

                <xpath expr="//page[@name='general_information']/group" position="attributes">
                    <attribute name="readonly">is_readonly_for_sales_view</attribute>
                </xpath>

                <xpath expr="//field[@name='sale_ok']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>
                <xpath expr="//field[@name='purchase_ok']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement,!contact_stage_bar.group_lgd_sales,!contact_stage_bar.group_lgd_regional_sales_head,!contact_stage_bar.group_lgd_sales_manager</attribute>
                </xpath>
                <xpath expr="//field[@name='type']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>

                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement,!contact_stage_bar.group_lgd_sales</attribute>
                </xpath>
                <!-- Stock Number (Vendor SKU) on the product form: hide from LGD Sales. -->
                <xpath expr="//field[@name='stock_number']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_sales</attribute>
                </xpath>
                <!-- "Update Quantity" header + stat buttons: hidden from every user. -->
                <xpath expr="//button[@name='action_update_quantity_on_hand']"
                       position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='is_storable']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>
                <!-- Hide Certificate Type for LGD Procurement users -->
                <xpath expr="//field[@name='certificate_type']" position="attributes">
                    <attribute name="groups">!contact_stage_bar.group_lgd_procurement</attribute>
                </xpath>
                <!-- Rename Barcode to Certificate Number for all users -->
                <xpath expr="//field[@name='barcode']" position="attributes">
                    <attribute name="string">Certificate Number</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>