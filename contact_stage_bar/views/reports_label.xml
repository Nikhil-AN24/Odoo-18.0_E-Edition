    <record id="contact_stage_bar.paperformat_label_6x3" model="report.paperformat">
    <field name="name">Label 6x3 inch</field>
    <field name="default" eval="False"/>
    <field name="format">custom</field>
    <field name="page_width">76</field>   <!-- 6 inches ≈ 152 mm -->
    <field name="page_height">152</field>   <!-- 3 inches ≈ 76 mm -->
    <field name="margin_top">1</field>
    <field name="margin_bottom">1</field>
    <field name="margin_left">1</field>
    <field name="margin_right">1</field>
    <field name="orientation">Landscape</field>
    <field name="header_line" eval="False"/>
</record>

<record id="action_material_tag" model="ir.actions.report">
    <field name="name">Delivery Report</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">contact_stage_bar.report_material_tag_document</field>
    <field name="report_file">contact_stage_bar.report_material_tag_document</field>
    <field name="print_report_name">'Delivery Report - %s' % (object.name)</field>
    <field name="binding_model_id" ref="model_stock_picking"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="contact_stage_bar.paperformat_label_6x3"/>
</record>


<template id="contact_stage_bar.report_material_tag_document">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="doc">
            <main>
                <div class="page" style="width:100%; height:100%; padding:8px; font-size:12px; border:2px solid black; box-sizing:border-box;">

                <!-- <div class="page" style="width: 6in; height: 3in; padding: 8px; font-size: 12px; border: 2px solid black; box-sizing: border-box;"> -->
                    
                    <!-- Title -->
                    <h3 style="text-align:center; margin:0; padding:0;">
                        AUGMONT PRIVATE LIMITED
                    </h3>
                    <!-- <h4 style="text-align:center; margin:0; padding:0; font-weight:normal;">
                        DELIVERY SLIP - PRODUCT LABEL
                    </h4> -->

                    <!-- Table with Borders -->
                    <table style="width:100%; border-collapse: collapse; font-size: 12px; margin-top:5px;">
                        <tr>
                            <td style="width:35%; font-weight:bold; border:1px solid black; padding:3px;">Online Order Number :</td>
                            <td style="width:65%; border:1px solid black; padding:3px;">
                                <span t-esc="doc.sdk_augmont_number"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:35%; font-weight:bold; border:1px solid black; padding:3px;">CUSTOMER :</td>
                            <td style="width:65%; border:1px solid black; padding:3px;">
                                <span t-esc="doc.partner_id.name"/>
                            </td>
                        </tr>
                         <tr>
                            <td style="width:35%; font-weight:bold; border:1px solid black; padding:3px;">MOBILE :</td>
                            <td style="width:65%; border:1px solid black; padding:3px;">
                                <span t-esc="doc.partner_id.phone"/>
                            </td>
                        </tr>

                        <!-- <tr>
                            <td style="font-weight:bold; border:1px solid black; padding:3px;">PRODUCT :</td>
                            <td style="border:1px solid black; padding:3px;">
                                <t t-foreach="doc.move_ids_without_package" t-as="line">
                                    <span t-esc="line.product_id.display_name"/><br/>
                                </t>
                            </td>
                        </tr> -->

                        <!-- <tr>
                            <td style="font-weight:bold; border:1px solid black; padding:3px;">BILLING ADDRESS :</td>
                            <td style="border:1px solid black; padding:3px;">
                                <span t-esc="doc.billing_address"/>
                            </td>
                        </tr> -->

                        <tr>
                            <td style="font-weight:bold; border:1px solid black; padding:3px;">SHIPPING ADDRESS :</td>
                            <td style="border:1px solid black; padding:3px;">
                                <span t-esc="doc.shipping_address"/>
                            </td>
                        </tr>
                    </table>
                    

                </div>
            </main>
            <div style="margin-top:10px; text-align:center; font-size:12px; font-weight:bold;">
                        Return Delivery Note
                    </div>
                    <div style="margin-top:5px; text-align:center; font-size:12px; font-style:italic;">
                        <span t-esc="doc.company_id.name"/> - 
                        <span t-esc="doc.company_id.street"/> 
                        <span t-esc="doc.company_id.street2"/> , 
                        <span t-esc="doc.company_id.city"/> , 
                        <span t-esc="doc.company_id.state_id.name"/> ,
                        <span t-esc="doc.company_id.zip"/> ,
                        <span t-esc="doc.company_id.country_id.name"/>
                        <span t-esc="doc.company_id.phone"/>
                    </div>

        </t>
    </t>
</template>

</odoo>
