        <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'sale'),
                              ('name', 'in', ['sale_order_see_all',
                                              'sale_order_line_see_all'])]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <record id="sale.sale_order_see_all" model="ir.rule">
            <field name="domain_force">['|', ('user_id', '=', False), ('user_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]</field>
        </record>

        <record id="sale.sale_order_line_see_all" model="ir.rule">
            <field name="domain_force">['|', ('salesman_id', '=', False), ('salesman_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]</field>
        </record>

        <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'sale'),
                              ('name', 'in', ['sale_order_see_all',
                                              'sale_order_line_see_all'])]"/>
            </function>
            <value eval="{'noupdate': True}"/>
        </function>

        <record id="lgd_procurement_sale_order_rule" model="ir.rule">
            <field name="name">LGD Procurement Sale Order Visibility</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">['|', ('user_id', '=', False), ('user_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]</field>
            <field name="groups" eval="[(6, 0, [ref('contact_stage_bar.group_lgd_procurement')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
 
        <record id="lgd_procurement_sale_order_line_rule" model="ir.rule">
            <field name="name">LGD Procurement Sale Order Line Visibility</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">['|', ('salesman_id', '=', False), ('salesman_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]</field>
            <field name="groups" eval="[(6, 0, [ref('contact_stage_bar.group_lgd_procurement')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
 
        <record id="sale_order_admin_bypass" model="ir.rule">
            <field name="name">Admin Full Visibility Sale Order</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('base.group_erp_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
 
        <record id="sale_order_line_admin_bypass" model="ir.rule">
            <field name="name">Admin Full Visibility Sale Order Line</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('base.group_erp_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
 
    </data>
</odoo>
