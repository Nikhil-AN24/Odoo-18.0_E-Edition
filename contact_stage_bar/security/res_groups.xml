<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_lgd">
            <field name="name">LGD User Roles</field>
            <field name="description">Helps you manage LGD specific access rights.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_lgd_sales" model="res.groups">
            <field name="name">LGD Sales</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="group_lgd_sales_manager" model="res.groups">
            <field name="name">LGD Sales Manager</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('contact_stage_bar.group_lgd_sales')), (4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <record id="group_lgd_procurement" model="res.groups">
            <field name="name">LGD Procurement</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <record id="group_lgd_logistics" model="res.groups">
            <field name="name">LGD Logistics</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_lgd_shipment" model="res.groups">
            <field name="name">LGD Shipment</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_lgd_accounting" model="res.groups">
            <field name="name">LGD Accounting</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_lgd_hr" model="res.groups">
            <field name="name">LGD HR</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_lgd_marketing" model="res.groups">
            <field name="name">LGD Marketing</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('mass_mailing.group_mass_mailing_user'))]"/>
        </record>

        <!-- Sits above LGD Sales Manager: inherits the manager's Sales access
             and its partner record rule. -->
        <record id="group_lgd_regional_sales_head" model="res.groups">
            <field name="name">LGD Regional Sales Head</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('contact_stage_bar.group_lgd_sales_manager'))]"/>
        </record>


        <record id="group_lgd_quality" model="res.groups">
            <field name="name">LGD Quality</field>
            <field name="category_id" ref="module_category_lgd"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <!-- ================= Export restricted to administrators ============= -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('base.group_allow_export'))]"/>
        </record>

        <function model="res.users" name="_lgd_restrict_export_to_admins"/>

        <!-- The sale.order Actions dropdown (Cancel, Create invoice(s), Send an
             email, Mark Quotation as Sent, Share, Generate a Payment Link) is
             admin-only too. These are action bindings, so groups_id on each one
             is filtered by get_bindings() server-side. "Insert in spreadsheet"
             is not a binding and is handled in models/ir_http.py. -->
        <function model="res.users" name="_lgd_restrict_sale_order_bindings_to_admins"/>

        <record id="lgd_sales_own_partner_read_rule" model="ir.rule">
            <field name="name">LGD Sales Own Partner Read</field>
            <field name="model_id" ref="base.model_res_partner"/>

            <!-- Customer side = "not a supplier", NOT "tagged buyer". partner_kind
                 is only set when the record is created from a tagged menu or
                 inherits one from a parent, so the overwhelming majority of
                 contacts carry no kind at all. Requiring 'buyer' hid them from
                 the very reps who own them - including contacts a rep had just
                 created. '!=' matches NULL in Odoo domains, so untagged records
                 fall on the customer side while suppliers stay hidden.

                 The user_ids branch keeps colleagues' own partner records
                 readable. Followers on a shared order are internal users, and
                 without it the chatter raises AccessError on any order a
                 colleague follows. -->
            <field name="domain_force">['|', '|', '|',
                                        ('id', '=', user.partner_id.id),
                                        ('id', '=', user.company_id.partner_id.id),
                                        ('user_ids', '!=', False),
                                        '&amp;',
                                        '&amp;',
                                        ('partner_kind', '!=', 'supplier'),
                                        '|',
                                        ('parent_id', '=', False),
                                        ('parent_id.partner_kind', '!=', 'supplier'),
                                        '|', '|', '|',
                                        ('create_uid', '=', user.id),
                                        ('user_id', '=', user.id),
                                        ('parent_id.user_id', '=', user.id),
                                        ('sale_order_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(6, 0, [ref('contact_stage_bar.group_lgd_sales')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>


        <record id="lgd_global_partner_read_rule" model="ir.rule">
            <field name="name">LGD Global Partner Read Bypass</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('contact_stage_bar.group_lgd_logistics'),
                ref('contact_stage_bar.group_lgd_shipment'),
                ref('contact_stage_bar.group_lgd_accounting'),
                ref('contact_stage_bar.group_lgd_hr'),
                ref('contact_stage_bar.group_lgd_marketing')
            ])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="lgd_procurement_partner_rule" model="ir.rule">
            <field name="name">LGD Procurement Partner Access (Suppliers Only)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <!-- The user_ids branch keeps colleagues' own partner records
                 readable, for the same reason the LGD Sales rule carries it:
                 followers on a shared order are internal users, and without it
                 the chatter raises AccessError on any order a colleague
                 follows.

                 sale_order_ids covers the customer on an order Procurement can
                 already open. The Customer field itself is stripped from their
                 arch (see views/sale_order.xml), but Odoo re-injects partner_id
                 as an invisible dependency because the delivery/invoice address
                 fields name it in their context, and the client reads it. Read
                 access here is what stops that read raising AccessError; it does
                 not put the customer back on their screen. It also covers the
                 handful of partners that both buy and sell, which cannot be
                 tagged 'supplier' without hiding them from LGD Sales. -->
            <field name="domain_force">['|', '|', '|', '|', '|',
                                        ('id', '=', user.partner_id.id),
                                        ('id', '=', user.company_id.partner_id.id),
                                        ('user_ids', '!=', False),
                                        ('sale_order_ids', '!=', False),
                                        ('partner_kind', '=', 'supplier'),
                                        ('parent_id.partner_kind', '=', 'supplier')]</field>
            <field name="groups" eval="[(6, 0, [ref('contact_stage_bar.group_lgd_procurement')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="lgd_sales_manager_partner_read_rule" model="ir.rule">
            <field name="name">LGD Sales Manager Partner Read Bypass (Restricted)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <!-- Same customer-side test as the rep rule above, for the same
                 reason: 'tagged buyer' hid nearly every contact. -->
            <field name="domain_force">['|', '|', '|',
                                        ('id', '=', user.partner_id.id),
                                        ('id', '=', user.company_id.partner_id.id),
                                        ('user_ids', '!=', False),
                                        '&amp;',
                                        '&amp;',
                                        ('partner_kind', '!=', 'supplier'),
                                        '|',
                                        ('parent_id', '=', False),
                                        ('parent_id.partner_kind', '!=', 'supplier'),
                                        '|',
                                        ('user_id', '=', False),
                                        ('user_id.login', 'not in', ['ankit.mehta@augmont.com', 'aarav.bafna@augmont.com'])]</field>
            <field name="groups" eval="[(6, 0, [ref('contact_stage_bar.group_lgd_sales_manager')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="lgd_admin_partner_all_rule" model="ir.rule">
            <field name="name">LGD Admin Partner Full Access</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [ref('base.group_system')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Tag line vendors that predate the bifurcation, so the procurement
             rule above can actually match them. Idempotent: it only touches
             partners with no kind set. -->
        <function model="res.partner" name="_lgd_backfill_vendor_partner_kind"/>

        <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'sale'), ('name', 'in', ['sale_order_personal_rule', 'sale_order_line_personal_rule'])]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <record id="sale.sale_order_personal_rule" model="ir.rule">
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
       
        <record id="sale.sale_order_line_personal_rule" model="ir.rule">
            <field name="domain_force">[('salesman_id', '=', user.id)]</field>
        </record>

        <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'sale'), ('name', 'in', ['sale_order_personal_rule', 'sale_order_line_personal_rule'])]"/>
            </function>
            <value eval="{'noupdate': True}"/>
        </function>

    </data>
</odoo>