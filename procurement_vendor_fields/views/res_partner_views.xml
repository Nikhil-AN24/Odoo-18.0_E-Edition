<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vendor-only fields, placed right after Graduation Rate.
         contact_stage_bar adds graduation_rate to the partner form; this module
         depends on it so the xpath below resolves. supplier_rank is loaded
         invisibly so the vendor-only modifier can be evaluated. -->
    <record id="view_partner_form_vendor_fields" model="ir.ui.view">
        <field name="name">res.partner.form.vendor.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='graduation_rate']" position="after">
                <field name="supplier_rank" invisible="1"/>
                <field name="vendor_discount" invisible="1"/>
                <field name="certified_payment_term" invisible="1"/>
                <field name="non_certified_payment_term" invisible="1"/>
                <field name="kyc_document_filename" invisible="1"/>
                <field name="kyc_document" widget="binary" filename="kyc_document_filename"
                       string="KYC Document" invisible="supplier_rank == 0"/>
            </xpath>

            <!-- Hide these fields on the vendor form (supplier_rank > 0) -->
            <xpath expr="//field[@name='graduation_rate']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='lead_source']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='category_ids']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='primary_category_ids']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <!-- Hide Salesperson + EIN/GST fields on the vendor form too -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='ein_number']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='gst_stages']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='ein_status']" position="attributes">
                <attribute name="invisible">supplier_rank &gt; 0</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase.menu_procurement_management_supplier_name" model="ir.ui.menu">
        <field name="name">Vendors</field>
    </record>

    <!-- Add the vendor selection fields to the partner list view -->
    <record id="view_partner_list_vendor_fields" model="ir.ui.view">
        <field name="name">res.partner.list.vendor.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="vendor_discount" optional="show"/>
                <field name="certified_payment_term" optional="show"/>
                <field name="non_certified_payment_term" optional="show"/>
                <!-- Supplier import-sheet columns, off by default to keep the
                     list readable; togglable from the column picker. -->
                <field name="trading_name" optional="hide"/>
                <field name="kyc_company_name" optional="hide"/>
                <field name="lg_cert_discount" optional="hide"/>
                <field name="lg_non_cert_discount" optional="hide"/>
                <field name="natural_cert_discount" optional="hide"/>
                <field name="natural_non_cert_discount" optional="hide"/>
                <field name="lg_cert_payment_days" optional="hide"/>
                <field name="lg_non_cert_payment_days" optional="hide"/>
                <field name="natural_cert_payment_days" optional="hide"/>
                <field name="natural_non_cert_payment_days" optional="hide"/>
            </xpath>
            <!-- Hide Salesperson / Activities / City columns by default -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>
