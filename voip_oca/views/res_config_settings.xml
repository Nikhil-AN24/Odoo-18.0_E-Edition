<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_twilio_app" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.twilio.app</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Myoperator Integration" id="operator_app" string="Myoperator Integration" name="operator_app">
                        <block title="Myoperator API Settings" id="operator_api_settings">
                            <setting string="Myoperator Credentials">
                                <label for="operator_company_id" class="col-lg-4 o_light_label" string="Company ID"/>

                                <field name="operator_company_id" placeholder="Enter your Company ID" string="Company ID"/>
                                <label for="operator_secret_token" class="col-lg-4 o_light_label" string="Secret Token"/>
                                <field name="operator_secret_token" placeholder="Enter your Myoperator Secret Token" />
                                <label for="operator_x_api_key" class="col-lg-4 o_light_label" string="X-Api-Key"/>
                                <field name="operator_x_api_key" placeholder="Enter your Myoperator X-Api-Key" />
                                <label for="operator_caller_id" class="col-lg-4 o_light_label" string="Caller ID"/>
                                <field name="operator_caller_id" placeholder="Enter your Myoperator Caller ID" />
                                <label for="operator_public_ivr_id" class="col-lg-4 o_light_label" string="Public IVR ID"/>
                                <field name="operator_public_ivr_id" placeholder="Enter your Myoperator Public IVR ID" />
                                <label for="operator_region" class="col-lg-4 o_light_label" string="Region"/>
                                <field name="operator_region" placeholder="Enter your Myoperator Region" />
                                <label for="operator_group" class="col-lg-4 o_light_label" string="Group"/>
                                <field name="operator_group" placeholder="Enter your Myoperator Group" />
                                <label for="operator_url" class="col-lg-4 o_light_label" string="URL"/>
                                <field name="operator_url" placeholder="Enter your Myoperator URL" />
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>