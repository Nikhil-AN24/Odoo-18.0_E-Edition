<odoo>
    <record model="ir.ui.view" id="view_users_form">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="voip" string="VOIP">
                    <group>
                        <field name="voip_pbx_id" string="PBX" />
                        <field name="voip_username" string="Username" />
                        <field name="voip_password" password="True" string="Password" />
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='login']" position="after">
            <label for="operator_user_id" class="col-lg-4 o_light_label" string="USER ID"/>

                <field name="operator_user_id"/>
            <label for="pulse_agent_number" class="col-lg-4 o_light_label" string="Agent Number"/>

                <field name="pulse_agent_number"/>
            <!-- <label for="pulse_agent_password" class="col-lg-4 o_light_label" string="Agent Password"/>

                <field name="pulse_agent_password"/> -->
                
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_users_form_simple_modif">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="voip" string="VOIP">
                    <group>
                        <field name="voip_pbx_id" widget="selection" string="PBX" />
                        <field name="voip_username" string="Username" />
                        <field name="voip_password" password="True" string="Password" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
