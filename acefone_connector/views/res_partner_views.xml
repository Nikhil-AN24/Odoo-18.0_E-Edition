<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_acefone" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.acefone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="phone" position="attributes">
                <attribute name="widget"></attribute>
            </field>
            <field name="phone" position="after">
                <button name="action_acefone_click_to_call" type="object"
                        string="Call" icon="fa-phone" class="btn-link"
                        invisible="not phone"/>
            </field>
            <field name="mobile" position="attributes">
                <attribute name="widget"></attribute>
            </field>
            <field name="mobile" position="after">
                <button name="action_acefone_click_to_call_mobile" type="object"
                        string="Call" icon="fa-phone" class="btn-link"
                        invisible="not mobile"/>
            </field>
        </field>
    </record>
</odoo>
