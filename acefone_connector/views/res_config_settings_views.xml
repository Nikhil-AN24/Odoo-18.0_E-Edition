<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_acefone" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.acefone</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Acefone" string="Acefone"
                     data-key="acefone_connector">
                    <h2>Acefone Click to Call</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="acefone_base_url" string="API Base URL"/>
                                <div class="text-muted">
                                    UK/International or India platform URL given by Acefone
                                </div>
                                <field name="acefone_base_url"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="acefone_api_key" string="API Key (Recommended)"/>
                                <div class="text-muted">
                                    Generate this in Acefone portal under Services > Click To Call API.
                                    If filled, Email/Password below are ignored.
                                </div>
                                <field name="acefone_api_key" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="acefone_email" string="Acefone Email"/>
                                <div class="text-muted">Only used if API Key above is empty</div>
                                <field name="acefone_email"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="acefone_password" string="Acefone Password"/>
                                <div class="text-muted">Only used if API Key above is empty</div>
                                <field name="acefone_password" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="acefone_default_caller_id" string="Default Caller ID (DID)"/>
                                <div class="text-muted">Optional</div>
                                <field name="acefone_default_caller_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
