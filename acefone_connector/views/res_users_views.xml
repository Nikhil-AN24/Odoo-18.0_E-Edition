<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backend Settings > Users > full user form -->
    <record id="view_users_form_acefone" model="ir.ui.view">
        <field name="name">res.users.form.inherit.acefone</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Acefone Click to Call">
                    <field name="acefone_agent_number" placeholder="e.g. 9198XXXXXXXX"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- "My Profile / Preferences" simplified form, opened from the user avatar -->
    <record id="view_users_form_simple_modif_acefone" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.acefone</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[last()]" position="after">
                <group string="Acefone Click to Call">
                    <field name="acefone_agent_number" placeholder="e.g. 9198XXXXXXXX"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
