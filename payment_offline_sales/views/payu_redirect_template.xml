<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payu_redirect_form" name="PayU Auto-Submit Redirect">
        <html>
            <head>
                <meta charset="UTF-8"/>
                <title>Redirecting to PayU…</title>
                <style>
                    body { font-family: 'Helvetica Neue', Arial, sans-serif;
                           display: flex; align-items: center; justify-content: center;
                           min-height: 100vh; margin: 0; background: #f8f9fa; color: #212529; }
                    .card { background: #fff; padding: 36px 48px; border-radius: 8px;
                            box-shadow: 0 2px 12px rgba(0,0,0,0.08); text-align: center; max-width: 420px; }
                    .spinner { display: inline-block; width: 36px; height: 36px;
                               border: 4px solid #e9ecef; border-top-color: #5e60ce;
                               border-radius: 50%; animation: spin 0.8s linear infinite; margin: 8px auto 18px; }
                    @keyframes spin { to { transform: rotate(360deg); } }
                    .btn { margin-top: 16px; background: #5e60ce; color: #fff; padding: 10px 24px;
                           border: none; border-radius: 4px; cursor: pointer; font-size: 14px; }
                </style>
            </head>
            <body>
                <div class="card">
                    <div class="spinner"/>
                    <h3 style="margin: 0 0 8px;">Redirecting to PayU…</h3>
                    <p style="color:#6c757d; font-size:14px;">
                        Please wait while we connect you to the secure payment gateway.
                    </p>
                    <form id="payu_form" method="POST" t-att-action="payu_url">
                        <t t-foreach="payload" t-as="field">
                            <input type="hidden" t-att-name="field" t-att-value="payload[field]"/>
                        </t>
                        <noscript>
                            <p style="color:#dc3545; margin-top:16px;">
                                JavaScript is required to redirect automatically.
                                Please click the button below to continue.
                            </p>
                            <button type="submit" class="btn">Continue to PayU</button>
                        </noscript>
                    </form>
                </div>
                <script type="text/javascript">
                    document.getElementById('payu_form').submit();
                </script>
            </body>
        </html>
    </template>

    <template id="stripe_result" name="Stripe Payment Result">
        <html>
            <head>
                <meta charset="UTF-8"/>
                <title>Payment Status</title>
                <style>
                    body { font-family: 'Helvetica Neue', Arial, sans-serif;
                           display: flex; align-items: center; justify-content: center;
                           min-height: 100vh; margin: 0; background: #f8f9fa; color: #212529; }
                    .card { background: #fff; padding: 36px 48px; border-radius: 8px;
                            box-shadow: 0 2px 12px rgba(0,0,0,0.08); text-align: center; max-width: 460px; }
                </style>
            </head>
            <body>
                <div class="card">
                    <t t-if="success">
                        <h3 style="color:#2f9e44; margin:0 0 12px;">Payment Successful</h3>
                        <p style="color:#495057; font-size:15px;">
                            Thank you. Your payment for order
                            <strong><t t-out="order_name"/></strong> has been received.
                        </p>
                    </t>
                    <t t-else="">
                        <h3 style="color:#e8590c; margin:0 0 12px;">Payment Cancelled</h3>
                        <p style="color:#495057; font-size:15px;">
                            Your payment for order <strong><t t-out="order_name"/></strong>
                            was not completed. You can use the payment link again to retry.
                        </p>
                    </t>
                    <p style="color:#868e96; font-size:13px; margin-top:24px;">
                        For any questions, please contact your sales representative.
                    </p>
                </div>
            </body>
        </html>
    </template>

    <template id="payu_redirect_error" name="PayU Redirect Error">
        <html>
            <head>
                <meta charset="UTF-8"/>
                <title>Payment Link Issue</title>
                <style>
                    body { font-family: 'Helvetica Neue', Arial, sans-serif;
                           display: flex; align-items: center; justify-content: center;
                           min-height: 100vh; margin: 0; background: #f8f9fa; color: #212529; }
                    .card { background: #fff; padding: 36px 48px; border-radius: 8px;
                            box-shadow: 0 2px 12px rgba(0,0,0,0.08); text-align: center; max-width: 480px; }
                </style>
            </head>
            <body>
                <div class="card">
                    <h3 style="color:#dc3545; margin: 0 0 12px;">Payment Link Issue</h3>
                    <p style="color:#495057; font-size:15px;"><t t-out="message"/></p>
                    <p style="color:#868e96; font-size:13px; margin-top:24px;">
                        Please contact your sales representative for assistance.
                    </p>
                </div>
            </body>
        </html>
    </template>
</odoo>
